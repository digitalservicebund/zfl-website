scopeconfig:
  - scope: node
allowed_patterns:
  - \@[a-z0-9]{40} # Allow fixing action hashes
  - "secrets: inherit"
  - 'key: \${{ runner.os }}'
  - public key
  - secrets.GITHUB_TOKEN
  - posthogKey
  - secret-scan
  - routeKey
  - RouteKey
  - toRouteKey
  - "route key"
  - RouteMetaKey
  - childKey
  - enterkeyhint
  - event\.key
  - shiftKey
  - parentKey
  - getRouteByKey
  - keydown
  - KeyDown
  - keyboard
  - Keyboard
  - keyword
  - Keyword
  - fuzzyKeyword
  - aria-keyshortcuts
  - key
  - handleKeydown
  - passes
  - nodeKey
  - diagramNodeKey
version: "1.0"
