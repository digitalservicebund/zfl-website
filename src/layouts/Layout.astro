---
import SearchModal from "@/components/search/SearchModal.astro";
import Footer from "@/components/global/Footer.astro";
import PageHeader from "@/components/global/PageHeader.astro";
import SectionSidebar from "@/components/global/SectionSidebar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getRouteByPath,
  getRouteChain,
  hasVisibleChildren,
} from "@/utils/navigation/routeUtils";

interface Props {
  title: string;
  description?: string;
  excludeFromSearch?: boolean;
  pagefindWeight?: number;
  noMenu?: boolean;
}

const { title, description, excludeFromSearch, pagefindWeight, noMenu } =
  Astro.props;

const currentRoute = getRouteByPath(Astro.url.pathname);
const [sectionRoot] = currentRoute ? getRouteChain(currentRoute) : [];
const showSectionSidebar =
  !!sectionRoot && hasVisibleChildren(sectionRoot) && !noMenu;
---

<BaseLayout title={title} description={description}>
  <PageHeader />
  <div
    data-pagefind-default-meta="pageType:Seite"
    {...(!excludeFromSearch && { "data-pagefind-body": "" })}
    {...(pagefindWeight && { "data-pagefind-weight": pagefindWeight })}
  >
    {showSectionSidebar ? (
      <div class="h-full min-[900px]:grid min-[900px]:grid-cols-[264px_minmax(0,1fr)]">
        <SectionSidebar />
        <slot />
      </div>
    ) : (
      <slot />
    )}
  </div>
  <Footer />
  <SearchModal />
</BaseLayout>
