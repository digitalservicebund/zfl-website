---
summary: "Zeigt die Grundpflichten eines Verantwortlichen im Brennstoffemissionshandel mit zuständiger Behörde und Prüfstelle: Genehmigung des (vereinfachten) Überwachungsplans, jährliche Ermittlung, Verifizierung und Berichterstattung der Brennstoffemissionen sowie fristgerechte Abgabe der Emissionszertifikate."
---
swimlane-beta TD
    subgraph ZB["Zuständige Behörde"]
        pruef{"Entspricht der Überwachungsplan den<br/>Vorgaben der Rechtsverordnung nach Abs. 5?<br/>— <a href='{{ELI}}#art-z6_abs-z2' target='_blank' rel='noopener'>§6 Abs. 2 S. 1</a><br/>Beim vereinfachten Plan: Erklärung, nur<br/>Standardemissionsfaktoren anzuwenden, und<br/>Methodik zur Erfassung von Art und Menge<br/>der Brennstoffe entspricht diesen Vorgaben?<br/>— <a href='{{ELI}}#art-z6_abs-z3' target='_blank' rel='noopener'>§6 Abs. 3 S. 1</a>"}
        aufforderung{"Aufforderung binnen 2 Monaten nach<br/>Einreichung, festgestellte Mängel zu<br/>beseitigen oder fehlende Erläuterungen<br/>nachzureichen?<br/>— <a href='{{ELI}}#art-z6_abs-z3' target='_blank' rel='noopener'>§6 Abs. 3 S. 3</a>"}
        genehmigung["Genehmigung erteilt bzw. gilt als erteilt<br/>(ggf. mit Auflagen für Überwachung und<br/>Berichterstattung — <a href='{{ELI}}#art-z6_abs-z2' target='_blank' rel='noopener'>§6 Abs. 2 S. 3</a>)<br/>— <a href='{{ELI}}#art-z6_abs-z1' target='_blank' rel='noopener'>§6 Abs. 1 S. 3</a>"]
    end

    subgraph VA["Verantwortlicher"]
        start(["Reicht für jede Handelsperiode bei der<br/>zuständigen Behörde einen Überwachungsplan<br/>ein — <a href='{{ELI}}#art-z6_abs-z1' target='_blank' rel='noopener'>§6 Abs. 1 S. 1</a>; bei Ermittlung<br/>ausschließlich unter Anwendung von<br/>Standardemissionsfaktoren genügt ein<br/>vereinfachter Überwachungsplan<br/>— <a href='{{ELI}}#art-z6_abs-z1' target='_blank' rel='noopener'>§6 Abs. 1 S. 2</a>"])
        maengel(["Festgestellte Mängel innerhalb der<br/>festgesetzten Frist beseitigen und<br/>geänderten Plan vorlegen<br/>— <a href='{{ELI}}#art-z6_abs-z2' target='_blank' rel='noopener'>§6 Abs. 2 S. 2</a>, <a href='{{ELI}}#art-z6_abs-z3' target='_blank' rel='noopener'>Abs. 3 S. 2</a>"])
        ermitteln["Ermittelt die Brennstoffemissionen der im<br/>Kalenderjahr in Verkehr gebrachten Brennstoffe<br/>auf Grundlage des Überwachungsplans<br/>— <a href='{{ELI}}#art-z7_abs-z1' target='_blank' rel='noopener'>§7 Abs. 1</a><br/>(Plan bei Änderungen nach Abs. 4 Nr. 1-3<br/>unverzüglich anpassen und einreichen<br/>— <a href='{{ELI}}#art-z6_abs-z4' target='_blank' rel='noopener'>§6 Abs. 4</a>)"]
        bericht["Berichtet der zuständigen Behörde bis<br/>31. Juli des Folgejahres über die<br/>Brennstoffemissionen — <a href='{{ELI}}#art-z7_abs-z1' target='_blank' rel='noopener'>§7 Abs. 1</a>"]
        abgabe(["Gibt bis 30. September Emissionszertifikate<br/>entsprechend der nach §7 berichteten<br/>Gesamtmenge des Vorjahres an die<br/>zuständige Behörde ab — <a href='{{ELI}}/art-z8' target='_blank' rel='noopener'>§8</a>"])
    end

    subgraph PS["Prüfstelle"]
        verifizierung["Verifiziert die Angaben im<br/>Emissionsbericht (Prüfstelle nach<br/><a href='{{ELI}}/art-z15' target='_blank' rel='noopener'>§15</a>) — <a href='{{ELI}}#art-z7_abs-z3' target='_blank' rel='noopener'>§7 Abs. 3</a>"]
    end

    start --> pruef
    pruef -->|"Nein: Überwachungsplan"| maengel
    pruef -->|"Nein: vereinfachter<br/>Überwachungsplan"| aufforderung
    aufforderung -->|Ja| maengel
    aufforderung -->|"Nein: gilt<br/>als erteilt"| genehmigung
    pruef -->|Ja| genehmigung
    genehmigung --> ermitteln
    ermitteln --> verifizierung
    verifizierung --> bericht
    bericht --> abgabe
    maengel ~~~ ermitteln

    style maengel fill:#fff3cd,stroke:#c9a227
    style abgabe fill:#d4edda,stroke:#2d8a4a
