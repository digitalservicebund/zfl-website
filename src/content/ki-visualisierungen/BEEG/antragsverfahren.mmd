---
summary: "Zeigt das Antragsverfahren für Elterngeld nach dem BEEG mit antragstellendem Elternteil, anderer berechtigter Person, zuständiger Behörde, Arbeitgeber und Standesamt: schriftlicher Antrag, Einkommens- und Arbeitszeitnachweis, vorläufige Entscheidung oder Zahlung unter Widerrufsvorbehalt und Auszahlung."
---
swimlane-beta TD
    subgraph EL["Antragstellender Elternteil"]
        start(["Beantragt Elterngeld schriftlich und gibt an,<br/>für welche Lebensmonate Basiselterngeld,<br/>Elterngeld Plus oder Partnerschaftsbonus<br/>beantragt wird — <a href='{{ELI}}#art-z7_abs-z1' target='_blank' rel='noopener'>§7 Abs. 1 S. 1, 3</a>"])
        allein{"Fall des §4c oder Antrag durch<br/>allein sorgeberechtigte Person?<br/>— <a href='{{ELI}}#art-z7_abs-z3' target='_blank' rel='noopener'>§7 Abs. 3 S. 1</a>"}
        nachweis(["Weist nach Ablauf des Bezugszeitraums<br/>das tatsächliche Einkommen aus<br/>Erwerbstätigkeit nach — <a href='{{ELI}}#art-z8_abs-z1' target='_blank' rel='noopener'>§8 Abs. 1</a>"])
    end

    subgraph AP["Andere berechtigte Person"]
        unterschrift["Unterschreibt den Antrag zur<br/>Bestätigung der Kenntnisnahme<br/>— <a href='{{ELI}}#art-z7_abs-z3' target='_blank' rel='noopener'>§7 Abs. 3 S. 1</a>"]
        eigener{"Stellt gleichzeitig eigenen Antrag<br/>oder zeigt an, wie viele Monatsbeträge<br/>sie beansprucht (bei Überschreitung der<br/>Höchstgrenzen nach §4 Abs. 3 i.V.m. §4b)?<br/>— <a href='{{ELI}}#art-z7_abs-z3' target='_blank' rel='noopener'>§7 Abs. 3 S. 2</a>"}
        rest["Sämtliche Monatsbeträge gehen an die<br/>antragstellende Person; bei späterem Antrag<br/>nur die vom Gesamtanspruch verbleibenden<br/>Monatsbeträge — <a href='{{ELI}}#art-z7_abs-z3' target='_blank' rel='noopener'>§7 Abs. 3 S. 3</a>"]
    end

    subgraph BH["Zuständige Behörde"]
        eingang["Eingang des Antrags bei der Behörde des<br/>Bezirks, in dem das Kind bei erster Antragstellung<br/>seinen inländischen Wohnsitz hat (sonst nach S. 3)<br/>— <a href='{{ELI}}#art-z12_abs-z1' target='_blank' rel='noopener'>§12 Abs. 1</a>; rückwirkend nur für die letzten<br/>3 Lebensmonate vor dem Eingangsmonat<br/>— <a href='{{ELI}}#art-z7_abs-z1' target='_blank' rel='noopener'>§7 Abs. 1 S. 2</a>"]
        abruf["Ruft zur Prüfung des Anspruchs nach §1<br/>Geburtsdaten automatisiert beim Standesamt ab,<br/>wenn die antragstellende Person eingewilligt hat<br/>— <a href='{{ELI}}/art-z25' target='_blank' rel='noopener'>§25</a>"]
        verlangen["Verlangt, soweit zum Nachweis erforderlich,<br/>eine Bescheinigung vom (ehemaligen) Arbeitgeber<br/>— <a href='{{ELI}}#art-z9_abs-z1' target='_blank' rel='noopener'>§9 Abs. 1</a>; für das Einkommen auch<br/>elektronische Abfrage nach §108a SGB IV, wenn<br/>der/die Beschäftigte eingewilligt hat<br/>— <a href='{{ELI}}#art-z9_abs-z2' target='_blank' rel='noopener'>§9 Abs. 2 S. 1-2</a>"]
        vorlaeufig{"Steuerbescheid fehlt und Überschreitung<br/>nach §1 Abs. 8 noch offen, Einkommen vor<br/>der Geburt nicht ermittelbar oder voraus-<br/>sichtlich Einkommen im Bezugszeitraum?<br/>— <a href='{{ELI}}#art-z8_abs-z3' target='_blank' rel='noopener'>§8 Abs. 3</a>"}
        widerruf{"Voraussichtlich kein Einkommen im<br/>Bezugszeitraum, oder Steuerbescheid fehlt und<br/>Beträge nach §1 Abs. 8 voraussichtlich<br/>nicht überschritten? — <a href='{{ELI}}#art-z8_abs-z2' target='_blank' rel='noopener'>§8 Abs. 2</a>"}
        zahlung["Zahlung im Laufe des Lebensmonats,<br/>für den das Elterngeld bestimmt ist<br/>— <a href='{{ELI}}/art-z6' target='_blank' rel='noopener'>§6</a>"]
    end

    subgraph AGB["Arbeitgeber"]
        bescheinigung["Bescheinigt auf Verlangen Arbeitsentgelt,<br/>Abzugsmerkmale (§§2e, 2f) und Arbeitszeit<br/>(bei Heimarbeit: Auftraggeber oder<br/>Zwischenmeister) — <a href='{{ELI}}#art-z9_abs-z1' target='_blank' rel='noopener'>§9 Abs. 1</a>;<br/>mit systemgeprüftem Entgeltabrechnungs-<br/>programm: elektronische Übermittlung<br/>— <a href='{{ELI}}#art-z9_abs-z2' target='_blank' rel='noopener'>§9 Abs. 2 S. 3</a>"]
    end

    subgraph SA["Standesamt"]
        geburt("Daten über die Beurkundung der Geburt:<br/>Tag und Ort der Geburt, Namen des Kindes<br/>und der Eltern — <a href='{{ELI}}/art-z25' target='_blank' rel='noopener'>§25</a>")
    end

    start --> allein
    allein -->|Ja| eingang
    allein -->|Nein| unterschrift
    unterschrift --> eigener
    eigener -->|Ja| eingang
    eigener -->|Nein| rest
    rest --> eingang
    eingang --> abruf
    abruf -.-> geburt
    abruf --> verlangen
    verlangen --> bescheinigung
    bescheinigung --> vorlaeufig
    vorlaeufig -->|"Ja: vorläufige Entscheidung<br/>über die Höhe (glaubhaft<br/>gemachte Angaben)"| zahlung
    vorlaeufig -->|Nein| widerruf
    widerruf -->|"Ja: unter Vorbehalt<br/>des Widerrufs"| zahlung
    widerruf -->|Nein| zahlung
    zahlung -->|"bei Angaben zu voraus-<br/>sichtlichem Einkommen"| nachweis

    style zahlung fill:#d4edda,stroke:#2d8a4a
    style rest fill:#fff3cd,stroke:#c9a227
    style nachweis fill:#fff3cd,stroke:#c9a227
