---
summary: "Zeigt den Ablauf bei einer Verletzung des Schutzes personenbezogener Daten mit Auftragsverarbeiter, Verantwortlichem, Aufsichtsbehörde und betroffener Person: die Meldung an die Aufsichtsbehörde binnen 72 Stunden nach Art. 33 DSGVO und die Benachrichtigung der betroffenen Person nach Art. 34 DSGVO."
---
swimlane-beta TD
    subgraph AV["Auftragsverarbeiter"]
        avKenntnis(["Verletzung wird beim<br/>Auftragsverarbeiter bekannt"])
        avMeldung["Meldung an den Verantwortlichen<br/>unverzüglich nach Bekanntwerden<br/>— Art. 33 Abs. 2"]
    end

    subgraph VA["Verantwortlicher"]
        start(["Verletzung des Schutzes<br/>personenbezogener Daten<br/>wird bekannt"])
        dokumentation["Dokumentation der Verletzung,<br/>ihrer Folgen und Abhilfemaßnahmen<br/>— Art. 33 Abs. 5"]
        risiko{"Voraussichtlich kein Risiko<br/>für Rechte und Freiheiten<br/>natürlicher Personen?<br/>— Art. 33 Abs. 1"}
        keineMeldung(["Keine Meldung an die<br/>Aufsichtsbehörde erforderlich"])
        meldung["Meldung an zuständige Aufsichtsbehörde<br/>unverzüglich, möglichst binnen 72 Stunden,<br/>sonst mit Begründung der Verzögerung:<br/>Art der Verletzung, Kontaktstelle,<br/>Folgen und Abhilfemaßnahmen<br/>— Art. 33 Abs. 1, 3"]
        hohesRisiko{"Voraussichtlich hohes Risiko<br/>für Rechte und Freiheiten<br/>der betroffenen Person?<br/>— Art. 34 Abs. 1"}
        ausnahmeAB{"Schutzvorkehrungen vorab getroffen<br/>(z.B. Verschlüsselung) oder hohes<br/>Risiko nachträglich beseitigt?<br/>— Art. 34 Abs. 3 lit. a, b"}
        aufwand{"Benachrichtigung mit unverhältnis-<br/>mäßigem Aufwand verbunden?<br/>— Art. 34 Abs. 3 lit. c"}
        benachrichtigung["Benachrichtigung der betroffenen<br/>Person unverzüglich, in klarer<br/>und einfacher Sprache<br/>— Art. 34 Abs. 1–2"]
        bekanntmachung["Öffentliche Bekanntmachung<br/>statt Einzelbenachrichtigung<br/>— Art. 34 Abs. 3 lit. c"]
    end

    subgraph AB["Aufsichtsbehörde"]
        eingang("Meldung geht ein<br/>— Art. 33 Abs. 1")
        nachholen{"Verlangt die Aufsichtsbehörde,<br/>die Benachrichtigung nachzuholen?<br/>— Art. 34 Abs. 4"}
        abgeschlossen(["Verfahren abgeschlossen"])
    end

    subgraph BP["Betroffene Person"]
        informiert(["Ist über die Verletzung<br/>und ihre Folgen informiert<br/>— Art. 34 Abs. 2, 3 lit. c"])
    end

    avKenntnis --> avMeldung
    avMeldung --> start
    start --> dokumentation
    dokumentation --> risiko
    risiko -->|Ja| keineMeldung
    risiko -->|"Nein/unklar"| meldung
    meldung --> eingang
    meldung --> hohesRisiko
    hohesRisiko -->|Ja| ausnahmeAB
    hohesRisiko -->|"Nein: keine<br/>Benachrichtigung"| nachholen
    ausnahmeAB -->|"Ja: keine<br/>Benachrichtigung"| nachholen
    ausnahmeAB -->|Nein| aufwand
    aufwand -->|Nein| benachrichtigung
    aufwand -->|Ja| bekanntmachung
    eingang -.-> nachholen
    nachholen -->|Ja| benachrichtigung
    nachholen -->|Nein| abgeschlossen
    benachrichtigung --> informiert
    bekanntmachung --> informiert

    style informiert fill:#d4edda,stroke:#2d8a4a
    style abgeschlossen fill:#d4edda,stroke:#2d8a4a
    style keineMeldung fill:#fff3cd,stroke:#c9a227
