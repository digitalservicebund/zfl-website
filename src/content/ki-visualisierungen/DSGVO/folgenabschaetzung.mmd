---
summary: "Zeigt, wann der Verantwortliche eine Datenschutz-Folgenabschätzung nach Art. 35 DSGVO unter Beteiligung des Datenschutzbeauftragten durchführen muss und wann er anschließend die Aufsichtsbehörde nach Art. 36 DSGVO vorher konsultieren muss."
---
swimlane-beta TD
    subgraph VA["Verantwortlicher"]
        start(["Verarbeitung geplant,<br/>insb. mit neuen<br/>Technologien<br/>— Art. 35 Abs. 1"])
        risiko{"Voraussichtlich hohes<br/>Risiko für Rechte und<br/>Freiheiten natürlicher<br/>Personen aufgrund Art,<br/>Umfang, Umständen,<br/>Zwecken? (insb. Abs. 3<br/>lit. a–c, Liste nach Abs. 4)<br/>— Art. 35 Abs. 1, 3, 4"}
        ausnahme{"Art. 6 Abs. 1 lit. c/e,<br/>Rechtsgrundlage regelt<br/>den konkreten Vorgang,<br/>Folgenabschätzung schon<br/>bei ihrem Erlass erfolgt?<br/>— Art. 35 Abs. 10"}
        keineDSFA(["Keine Datenschutz-<br/>Folgenabschätzung<br/>erforderlich (ggf. Liste<br/>nach Art. 35 Abs. 5)"])
        dsfa["Datenschutz-Folgen-<br/>abschätzung vorab<br/>durchführen (ähnliche<br/>Vorgänge ggf. gemeinsam)<br/>— Art. 35 Abs. 1"]
        inhalt["Mindestinhalt: Beschreibung<br/>und Zwecke, Notwendigkeit<br/>und Verhältnismäßigkeit,<br/>Risikobewertung, Abhilfe-<br/>maßnahmen — Art. 35 Abs. 7<br/>(Verhaltensregeln — Abs. 8;<br/>ggf. Standpunkt Betroffener<br/>— Abs. 9; erforderlichenfalls<br/>Überprüfung — Abs. 11)"]
        hohesRisiko{"Hätte die Verarbeitung<br/>laut Folgenabschätzung<br/>ein hohes Risiko, sofern<br/>keine Maßnahmen zur<br/>Eindämmung getroffen<br/>werden? — Art. 36 Abs. 1"}
        keineKonsultation(["Keine vorherige<br/>Konsultation<br/>erforderlich"])
        konsultation["Konsultiert Aufsichts-<br/>behörde vor der Verarbeitung<br/>mit Angaben nach Art. 36<br/>Abs. 3 lit. a–f (u.a. Folgen-<br/>abschätzung) — Art. 36 Abs. 1, 3"]
    end

    subgraph DSB["Datenschutzbeauftragter"]
        rat["Rat des Datenschutz-<br/>beauftragten, sofern<br/>benannt — Art. 35 Abs. 2"]
    end

    subgraph AB["Aufsichtsbehörde"]
        verstoss{"Stünde die Verarbeitung<br/>nach Auffassung der<br/>Aufsichtsbehörde nicht<br/>im Einklang mit der DSGVO<br/>(insb. Risiko nicht ausreichend<br/>ermittelt/eingedämmt)?<br/>— Art. 36 Abs. 2"}
        keineEmpfehlung(["Keine Empfehlung<br/>nach Art. 36 Abs. 2"])
        empfehlung(["Schriftliche Empfehlung<br/>an Verantwortlichen, ggf.<br/>Auftragsverarbeiter, binnen<br/>bis zu 8 Wochen (+6 Wochen,<br/>Aussetzung möglich); ggf.<br/>Befugnisse nach Art. 58<br/>— Art. 36 Abs. 2"])
    end

    start --> risiko
    risiko -->|Nein| keineDSFA
    risiko -->|Ja| ausnahme
    ausnahme -->|"Ja: Abs. 1–7 nur, wenn<br/>nach Ermessen der Mit-<br/>gliedstaaten erforderlich"| keineDSFA
    ausnahme -->|Nein| dsfa
    dsfa -->|"sofern<br/>benannt"| rat
    dsfa --> inhalt
    rat -.-> inhalt
    inhalt --> hohesRisiko
    hohesRisiko -->|Nein| keineKonsultation
    hohesRisiko -->|Ja| konsultation
    konsultation --> verstoss
    verstoss -->|Ja| empfehlung
    verstoss -->|Nein| keineEmpfehlung
    keineDSFA ~~~ dsfa
    keineKonsultation ~~~ konsultation
    keineEmpfehlung ~~~ empfehlung

    style keineDSFA fill:#fff3cd,stroke:#c9a227
    style keineKonsultation fill:#d4edda,stroke:#2d8a4a
    style keineEmpfehlung fill:#d4edda,stroke:#2d8a4a
    style empfehlung fill:#f8d7da,stroke:#c0392b
