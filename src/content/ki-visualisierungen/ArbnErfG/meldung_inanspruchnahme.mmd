---
summary: "Der Weg einer Diensterfindung vom Arbeitnehmer zum Arbeitgeber: Meldung in Textform, Eingangsbestätigung und Ergänzungsfrist von zwei Monaten sowie die Inanspruchnahme, die nach vier Monaten ohne Freigabe als erklärt gilt."
---
swimlane-beta TD
    subgraph AN["Arbeitnehmer"]
        start(["Erfindung während der Dauer<br/>des Arbeitsverhältnisses — <a href='{{ELI}}#art-z4_abs-z2' target='_blank' rel='noopener'>§4 II</a>"])
        dienst{"Aus der obliegenden Tätigkeit<br/>entstanden oder maßgeblich<br/>auf Erfahrungen oder Arbeiten<br/>des Betriebs beruhend?<br/>— <a href='{{ELI}}#art-z4_abs-z2' target='_blank' rel='noopener'>§4 II Nr. 1, 2</a>"}
        freieErf(["Freie Erfindung: nur Mitteilungs-<br/>und Anbietungspflicht — <a href='{{ELI}}#art-z4_abs-z3' target='_blank' rel='noopener'>§4 III</a>"])
        meldung["Unverzügliche, gesonderte<br/>Meldung in Textform<br/>— <a href='{{ELI}}#art-z5_abs-z1' target='_blank' rel='noopener'>§5 I</a>: Aufgabe, Lösung<br/>und Zustandekommen<br/>— <a href='{{ELI}}#art-z5_abs-z2' target='_blank' rel='noopener'>§5 II</a>"]
        ergaenzt["Ergänzt die Meldung, soweit erforderlich<br/>mit Unterstützung des Arbeitgebers<br/>— <a href='{{ELI}}#art-z5_abs-z3' target='_blank' rel='noopener'>§5 III S.2</a>"]
        frei(["Diensterfindung ist frei: Arbeitnehmer<br/>verfügt ohne Beschränkungen<br/>der §§18, 19 — <a href='{{ELI}}#art-z8_abs-z' target='_blank' rel='noopener'>§8</a>"])
        verguetung(["Anspruch auf angemessene<br/>Vergütung — <a href='{{ELI}}#art-z9_abs-z1' target='_blank' rel='noopener'>§9 I</a>"])
    end

    subgraph AG["Arbeitgeber"]
        bestaetigung["Bestätigt den Zeitpunkt des Eingangs<br/>unverzüglich in Textform — <a href='{{ELI}}#art-z5_abs-z1' target='_blank' rel='noopener'>§5 I S.3</a>"]
        ergaenzung{"Erklärt binnen 2 Monaten, dass<br/>und worin die Meldung einer<br/>Ergänzung bedarf? — <a href='{{ELI}}#art-z5_abs-z3' target='_blank' rel='noopener'>§5 III S.1</a>"}
        erklaerung{"Erklärung binnen 4 Monaten nach<br/>Eingang der ordnungsgemäßen Meldung?<br/>— <a href='{{ELI}}#art-z6_abs-z1' target='_blank' rel='noopener'>§6 I</a>, <a href='{{ELI}}#art-z6_abs-z2' target='_blank' rel='noopener'>§6 II</a>"}
        inanspruch["Inanspruchnahme: alle vermögenswerten<br/>Rechte gehen auf den Arbeitgeber über<br/>— <a href='{{ELI}}#art-z7_abs-z1' target='_blank' rel='noopener'>§7 I</a>; frühere Verfügungen des<br/>Arbeitnehmers insoweit unwirksam<br/>— <a href='{{ELI}}#art-z7_abs-z2' target='_blank' rel='noopener'>§7 II</a>"]
    end

    start --> dienst
    dienst -->|Nein| freieErf
    dienst -->|Ja| meldung
    meldung --> bestaetigung
    bestaetigung --> ergaenzung
    ergaenzung -->|Ja| ergaenzt
    ergaenzung -->|"Nein: Meldung gilt<br/>als ordnungsgemäß"| erklaerung
    ergaenzt -->|"ordnungsgemäße<br/>Meldung"| erklaerung
    erklaerung -->|"Freigabe<br/>in Textform"| frei
    erklaerung -->|"Inanspruchnahme erklärt<br/>oder keine Freigabe:<br/>gilt als erklärt"| inanspruch
    inanspruch --> verguetung

    style freieErf fill:#fff3cd,stroke:#c9a227
    style frei fill:#fff3cd,stroke:#c9a227
    style verguetung fill:#d4edda,stroke:#2d8a4a
