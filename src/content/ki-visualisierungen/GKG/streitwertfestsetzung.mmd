---
summary: "Zeigt die Festsetzung des Streitwerts für die Gerichtsgebühren nach §§ 61 bis 63 GKG von der Wertangabe über die vorläufige und endgültige Festsetzung durch das Prozessgericht bis zur Beschwerde nach § 68 GKG, der das Gericht abhilft oder die es dem nächsthöheren Gericht vorlegt."
---
swimlane-beta TD
    subgraph BET["Beteiligte"]
        angabe(["Wertangabe bei jedem Antrag, schriftlich<br/>oder zu Protokoll der Geschäftsstelle, sofern<br/>keine bestimmte Geldsumme, kein fester Wert<br/>und nicht aus früheren Anträgen ersichtlich<br/>(jederzeit berichtigbar) — <a href='{{ELI}}/art-z61' target='_blank' rel='noopener'>§61</a>"])
        beschwerde{"Beschwerde gegen den Festsetzungsbeschluss<br/>beim festsetzenden Gericht eingelegt?<br/>(statthaft, wenn Beschwerdegegenstand über<br/>300 Euro oder im Beschluss wegen<br/>grundsätzlicher Bedeutung zugelassen<br/>— <a href='{{ELI}}#art-z68_abs-z1' target='_blank' rel='noopener'>§68 I S.1, 2</a>, <a href='{{ELI}}#art-z66_abs-z5' target='_blank' rel='noopener'>§66 V S.5</a>)"}
        keineBeschwerde(["Festsetzung wird nicht angefochten<br/>(Änderung von Amts wegen nur binnen<br/>6 Monaten nach Rechtskraft oder<br/>Erledigung — <a href='{{ELI}}#art-z63_abs-z3' target='_blank' rel='noopener'>§63 III</a>)"])
    end

    subgraph PG["Prozessgericht"]
        vorlaeufigPruefung{"Streitwertabhängige Gebühren mit<br/>Einreichung fällig, keine bestimmte<br/>Geldsumme und kein fester Wert?<br/>(nicht in der Finanzgerichtsbarkeit)<br/>— <a href='{{ELI}}#art-z63_abs-z1' target='_blank' rel='noopener'>§63 I</a>"}
        vorlaeufig["Sogleich vorläufige Festsetzung durch<br/>Beschluss ohne Anhörung der Parteien<br/>(Einwendungen nur im Beschwerdeverfahren<br/>gegen eine Vorauszahlungsanordnung<br/>— <a href='{{ELI}}#art-z63_abs-z1' target='_blank' rel='noopener'>§63 I S.2</a>)"]
        endgueltig["Soweit keine bindende Wertfestsetzung für die<br/>Zuständigkeit oder Rechtsmittelzulässigkeit<br/>vorliegt (diese ist sonst auch für die Gebühren<br/>maßgebend, außer in Arbeitssachen — <a href='{{ELI}}/art-z62' target='_blank' rel='noopener'>§62</a>):<br/>Festsetzung durch Beschluss, sobald über<br/>den gesamten Streitgegenstand entschieden<br/>oder das Verfahren anderweitig erledigt ist<br/>— <a href='{{ELI}}#art-z63_abs-z2' target='_blank' rel='noopener'>§63 II S.1</a><br/>(Arbeits- und Finanzgerichtsbarkeit: nur auf<br/>Antrag eines Beteiligten oder der Staatskasse<br/>oder wenn angemessen — <a href='{{ELI}}#art-z63_abs-z2' target='_blank' rel='noopener'>§63 II S.2</a>;<br/>Kosten einer Abschätzung durch Sachverständige<br/>im Beschluss — <a href='{{ELI}}/art-z64' target='_blank' rel='noopener'>§64</a>)"]
        abhilfe{"Hält das Gericht die Beschwerde<br/>für zulässig und begründet?<br/>— <a href='{{ELI}}#art-z66_abs-z3' target='_blank' rel='noopener'>§66 III S.1</a> i.V.m. <a href='{{ELI}}#art-z68_abs-z1' target='_blank' rel='noopener'>§68 I S.5</a>"}
        abgeholfen(["Gericht hilft der<br/>Beschwerde ab"])
    end

    subgraph BG["Beschwerdegericht (nächsthöheres Gericht)"]
        frist{"Frist gewahrt (6 Monate nach Rechtskraft<br/>oder Erledigung, bei späterer Festsetzung<br/>1 Monat nach Zustellung oder Mitteilung<br/>— <a href='{{ELI}}#art-z68_abs-z1' target='_blank' rel='noopener'>§68 I S.3</a>) oder auf Antrag Wieder-<br/>einsetzung wegen unverschuldeter<br/>Verhinderung (Beschwerde binnen 2 Wochen<br/>nach Wegfall des Hindernisses, höchstens<br/>1 Jahr nach Fristende — <a href='{{ELI}}#art-z68_abs-z2' target='_blank' rel='noopener'>§68 II</a>)?"}
        unzulaessig(["Beschwerde ist unzulässig"])
        entscheidung(["Beschwerdegericht entscheidet, an die<br/>Zulassung gebunden; keine Beschwerde an<br/>einen obersten Gerichtshof des Bundes<br/>— <a href='{{ELI}}#art-z66_abs-z3' target='_blank' rel='noopener'>§66 III S.2-4</a><br/>(weitere Beschwerde zum OLG nur nach<br/>Zulassung durch das LG, binnen 1 Monat<br/>— <a href='{{ELI}}#art-z66_abs-z4' target='_blank' rel='noopener'>§66 IV</a>, <a href='{{ELI}}#art-z68_abs-z1' target='_blank' rel='noopener'>§68 I S.6</a>)"])
    end

    angabe --> vorlaeufigPruefung
    vorlaeufigPruefung -->|Ja| vorlaeufig
    vorlaeufigPruefung -->|Nein| endgueltig
    vorlaeufig --> endgueltig
    endgueltig --> beschwerde
    beschwerde -->|Nein| keineBeschwerde
    beschwerde -->|Ja| abhilfe
    abhilfe -->|Ja| abgeholfen
    abhilfe -->|"Nein: unverzügliche<br/>Vorlage"| frist
    frist -->|Ja| entscheidung
    frist -->|Nein| unzulaessig
    abgeholfen ~~~ frist

    style keineBeschwerde fill:#d4edda,stroke:#2d8a4a
    style abgeholfen fill:#d4edda,stroke:#2d8a4a
    style unzulaessig fill:#f8d7da,stroke:#c0392b
    style entscheidung fill:#fff3cd,stroke:#c9a227
