---
summary: "Zeigt die Kontrolle bei der Ausfuhr eines Gebrauchtfahrzeugs aus der Union: automatische Prüfung und risikobasierte Kontrolle durch die Zollbehörden, Aussetzung und Entscheidung der zuständigen Behörde sowie Überlassung oder Ablehnung und Vermerk im Fahrzeugregister."
---
swimlane-beta TD
    subgraph Person["An der Ausfuhr beteiligte Person"]
        start(["Gebrauchtfahrzeug soll ab dem 1.9.2031<br/>aus der Union ausgeführt werden<br/>— <a href='{{ELI}}#039.001' target='_blank' rel='noopener'>Art. 39 Abs. 1</a>"])
        angaben["Ausfuhranmeldung mit FIN, Mitgliedstaat<br/>der letzten Zulassung und Erklärung:<br/>kein Altfahrzeug, verkehrssicher<br/>(oder Bescheinigung nach Anhang II)<br/>— <a href='{{ELI}}#039.003' target='_blank' rel='noopener'>Art. 39 Abs. 3</a>, <a href='{{ELI}}#039.004' target='_blank' rel='noopener'>Abs. 4</a>"]
    end

    subgraph Zoll["Zollbehörden"]
        auto{"Angaben stimmen mit<br/>den Registern überein?<br/>— <a href='{{ELI}}#040.002' target='_blank' rel='noopener'>Art. 40 Abs. 2</a>"}
        keine1(["Keine Überlassung,<br/>Person wird unterrichtet<br/>— <a href='{{ELI}}#040.002' target='_blank' rel='noopener'>Art. 40 Abs. 2</a>"])
        risiko{"Grund zur Annahme,<br/>dass Anforderungen<br/>nicht erfüllt sind?<br/>— <a href='{{ELI}}#042.001' target='_blank' rel='noopener'>Art. 42 Abs. 1</a>"}
        aussetzen["Aussetzung der Überlassung,<br/>Unterrichtung der zuständigen Behörde<br/>— <a href='{{ELI}}#042.001' target='_blank' rel='noopener'>Art. 42 Abs. 1</a>"]
        keine2(["Keine Überlassung zur Ausfuhr<br/>— <a href='{{ELI}}#044.002' target='_blank' rel='noopener'>Art. 44 Abs. 2</a>"])
        ueberlassen["Überlassung zur Ausfuhr, automatische<br/>Meldung des Abgangs aus der Union<br/>— <a href='{{ELI}}#043.003' target='_blank' rel='noopener'>Art. 43 Abs. 3</a>"]
    end

    subgraph ZB["Zuständige Behörde (Art. 38)"]
        frist{"Bitte an die Zollbehörden, die Aussetzung<br/>aufrechtzuerhalten, binnen vier<br/>Arbeitstagen nach Beginn der Aussetzung?<br/>— <a href='{{ELI}}#043.001' target='_blank' rel='noopener'>Art. 43 Abs. 1 lit. a</a>"}
        pruefung{"Gelangt die zuständige Behörde zu<br/>dem Schluss, dass die Anforderungen<br/>des Kapitels nicht erfüllt sind?<br/>— <a href='{{ELI}}#044.001' target='_blank' rel='noopener'>Art. 44 Abs. 1</a>"}
        freigabe("Voraussetzung für die Überlassung<br/>erfüllt, sofern alle übrigen Anforderungen<br/>und Förmlichkeiten erfüllt sind<br/>— <a href='{{ELI}}#043.001' target='_blank' rel='noopener'>Art. 43 Abs. 1</a>")
    end

    subgraph FZB["Fahrzeugzulassungsbehörde"]
        vermerk(["Vermerk im nationalen Fahrzeugregister:<br/>in ein Drittland ausgeführt<br/>— <a href='{{ELI}}#043.003' target='_blank' rel='noopener'>Art. 43 Abs. 3</a>"])
    end

    start --> angaben
    angaben -->|"automatische Prüfung —<br/><a href='{{ELI}}#040.001' target='_blank' rel='noopener'>Art. 40 Abs. 1</a>"| auto
    auto -->|Nein| keine1
    auto -->|"Ja: risikobasierte Kontrolle —<br/><a href='{{ELI}}#041.001' target='_blank' rel='noopener'>Art. 41 Abs. 1</a>"| risiko
    risiko -->|Nein| ueberlassen
    risiko -->|Ja| aussetzen
    aussetzen -->|"ggf. Anforderung zusätzlicher<br/>Informationen — <a href='{{ELI}}#042.002' target='_blank' rel='noopener'>Art. 42 Abs. 2</a>"| frist
    frist -->|"Nein (lit. a)"| freigabe
    frist -->|Ja| pruefung
    pruefung -->|"Ja: Bitte um Nichtüberlassung<br/>— <a href='{{ELI}}#044.001' target='_blank' rel='noopener'>Art. 44 Abs. 1</a>"| keine2
    pruefung -->|"Nein: Zustimmung zur<br/>Überlassung (lit. b)"| freigabe
    freigabe --> ueberlassen
    ueberlassen --> vermerk

    keine1 ~~~ risiko

    style vermerk fill:#d4edda,stroke:#2d8a4a
    style keine1 fill:#f8d7da,stroke:#c0392b
    style keine2 fill:#f8d7da,stroke:#c0392b
