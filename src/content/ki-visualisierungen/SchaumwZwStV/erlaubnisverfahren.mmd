    H --> I["Laufender Betrieb:<br/>regelmäßige Überprüfung der<br/>Erlaubnisvoraussetzungen binnen 3 Jahren<br/>— <a href='{{ELI}}#art-z6a_abs-z' target='_blank' rel='noopener'>§6a</a>"]

