---
summary: "Die Wahl zwischen Überweisung zur Einziehung und an Zahlungs statt sowie die Rechte und Pflichten des Gläubigers bei der Einziehung einer gepfändeten Forderung: Auskunft des Schuldners, Klage mit Streitverkündung, Haftung bei Verzögerung und Verzicht."
---
flowchart TD
    start(["Geldforderung des Schuldners gegen<br/>den Drittschuldner ist gepfändet"])
    wahl{"Wahl des Gläubigers:<br/>Überweisung zur Einziehung<br/>oder an Zahlungs statt?<br/>— <a href='https://www.gesetze-im-internet.de/zpo/__835.html' target='_blank' rel='noopener'>§835 I</a>"}
    zahlungsstatt(["An Zahlungs statt zum Nennwert: Forderung<br/>geht auf den Gläubiger über; soweit sie<br/>besteht, gilt er als befriedigt — <a href='https://www.gesetze-im-internet.de/zpo/__835.html' target='_blank' rel='noopener'>§835 II</a>"])
    einziehung["Zur Einziehung: Überweisung ersetzt die<br/>förmlichen Erklärungen des Schuldners<br/>zur Einziehungsberechtigung — <a href='https://www.gesetze-im-internet.de/zpo/__836.html' target='_blank' rel='noopener'>§836 I</a>"]
    auskunft["Schuldner muss Auskunft erteilen und<br/>Urkunden über die Forderung herausgeben<br/>— <a href='https://www.gesetze-im-internet.de/zpo/__836.html' target='_blank' rel='noopener'>§836 III S.1</a>"]
    zahlt{"Zahlt der Drittschuldner?"}
    erhalten(["Gläubiger erhält Zahlung"])
    weiter{"Will der Gläubiger die<br/>Forderung weiter beitreiben?"}
    klage["Gläubiger klagt die Forderung gegen den<br/>Drittschuldner ein — <a href='https://www.gesetze-im-internet.de/zpo/__841.html' target='_blank' rel='noopener'>§841</a>"]
    streit(["Streitverkündung an den Schuldner, außer<br/>bei Zustellung im Ausland oder öffentlicher<br/>Zustellung — <a href='https://www.gesetze-im-internet.de/zpo/__841.html' target='_blank' rel='noopener'>§841</a>"])
    verzicht(["Verzicht auf die Rechte aus Pfändung<br/>und Überweisung (Anspruch gegen den<br/>Schuldner bleibt), Erklärung wird Schuldner<br/>und Drittschuldner zugestellt — <a href='https://www.gesetze-im-internet.de/zpo/__843.html' target='_blank' rel='noopener'>§843</a>"])

