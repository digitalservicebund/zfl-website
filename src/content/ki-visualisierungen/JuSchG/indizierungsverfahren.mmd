---
summary: "Veranschaulicht das Indizierungsverfahren der Prüfstelle für jugendgefährdende Medien nach §§21, 23 und 25 JuSchG mit antragstellender Stelle, zentraler Aufsichtsstelle der Länder und Betroffenen: vom Antrag über Anhörung und vereinfachtes Verfahren bis zur Zustellung und Klage."
---
swimlane-beta TD
    subgraph AS["Antragsberechtigte oder anregende Stelle"]
        antrag("Antrag einer antragsberechtigten Stelle<br/>— <a href='{{ELI}}#art-z21_abs-z2' target='_blank' rel='noopener'>§21 II</a> — oder Anregung einer anderen<br/>Behörde oder eines anerkannten Trägers der<br/>freien Jugendhilfe, wenn der Vorsitz das<br/>Verfahren im Interesse des Jugendschutzes<br/>für geboten hält — <a href='{{ELI}}#art-z21_abs-z4' target='_blank' rel='noopener'>§21 IV</a>")
        klageBehoerde(["Klage der antragstellenden Behörde<br/>im Verwaltungsrechtsweg gegen<br/>die Nichtaufnahme<br/>— <a href='{{ELI}}#art-z25_abs-z2' target='_blank' rel='noopener'>§25 II</a>"])
    end

    subgraph ZAS["Zentrale Aufsichtsstelle der Länder für den Jugendmedienschutz"]
        stellungZAS["Vor Aufnahme eines digitalen Dienstes:<br/>Gelegenheit zur unverzüglichen Stellungnahme;<br/>Prüfstelle berücksichtigt sie maßgeblich,<br/>ohne Stellungnahme nach 5 Werktagen<br/>Entscheidung möglich — <a href='{{ELI}}#art-z21_abs-z6' target='_blank' rel='noopener'>§21 VI</a>"]
    end

    subgraph PS["Prüfstelle für jugendgefährdende Medien"]
        vonAmts(["Tätigwerden von Amts wegen auf Veranlassung<br/>des Vorsitzes (z.B. Inhaltsgleichheit zweifelhaft,<br/>Aufnahmevoraussetzungen entfallen)<br/>— <a href='{{ELI}}#art-z21_abs-z5' target='_blank' rel='noopener'>§21 V</a>"])
        offensichtlich{"Listenaufnahme oder Streichung<br/>offensichtlich nicht in Betracht?<br/>— <a href='{{ELI}}#art-z21_abs-z3' target='_blank' rel='noopener'>§21 III</a>"}
        eingestellt(["Vorsitz kann das Verfahren einstellen<br/>— <a href='{{ELI}}#art-z21_abs-z3' target='_blank' rel='noopener'>§21 III</a> (Klage der antragstellenden<br/>Behörde möglich — <a href='{{ELI}}#art-z25_abs-z2' target='_blank' rel='noopener'>§25 II</a>)"])
        vereinfacht{"Vereinfachtes Verfahren: Medium offensichtlich<br/>jugendgefährdend (Nr. 1) oder digitaler Dienst<br/>auf Antrag oder nach Stellungnahme der<br/>zentralen Aufsichtsstelle (Nr. 2)? (nicht für<br/>Aufnahme nach §22 — <a href='{{ELI}}#art-z23_abs-z2' target='_blank' rel='noopener'>§23 II</a>)<br/>— <a href='{{ELI}}#art-z23_abs-z1' target='_blank' rel='noopener'>§23 I S.1</a>"}
        einstimmig{"Einstimmige Entscheidung durch Vorsitz und<br/>zwei weitere Mitglieder (eines aus den<br/>Gruppen des §19 II Nr. 1-4)?<br/>— <a href='{{ELI}}#art-z23_abs-z1' target='_blank' rel='noopener'>§23 I S.2-3</a>"}
        zustellung["Zustellung an Urheber, Nutzungsrechtsinhaber<br/>bzw. Anbieter und antragstellende Behörde mit<br/>Verbreitungs- und Werbebeschränkungen;<br/>Begründung beifügen oder binnen einer Woche<br/>nachreichen; Übermittlung u.a. an zentrale<br/>Aufsichtsstelle — <a href='{{ELI}}#art-z21_abs-z8' target='_blank' rel='noopener'>§21 VIII</a>"]
    end

    subgraph PV["Prüfstelle in voller Besetzung"]
        voll["Entscheidung in voller Besetzung<br/>— <a href='{{ELI}}#art-z23_abs-z1' target='_blank' rel='noopener'>§23 I S.4</a>, <a href='{{ELI}}#art-z19_abs-z5' target='_blank' rel='noopener'>§19 V</a>; Listenaufnahme<br/>mit Zwei-Drittel-Mehrheit — <a href='{{ELI}}#art-z19_abs-z6' target='_blank' rel='noopener'>§19 VI</a>"]
        vollNachAntrag["Entscheidung in voller Besetzung<br/>— <a href='{{ELI}}#art-z23_abs-z3' target='_blank' rel='noopener'>§23 III</a>"]
    end

    subgraph BT["Urheber, Nutzungsrechtsinhaber, Anbieter (Betroffene)"]
        anhoerung["Gelegenheit zur Stellungnahme, soweit<br/>Anschriften bekannt oder mit zumutbarem<br/>Aufwand ermittelbar — <a href='{{ELI}}#art-z21_abs-z7' target='_blank' rel='noopener'>§21 VII</a>"]
        antragVoll{"Antrag auf Entscheidung in voller<br/>Besetzung binnen eines Monats<br/>nach Zustellung? — <a href='{{ELI}}#art-z23_abs-z3' target='_blank' rel='noopener'>§23 III</a>"}
        keineKlage(["Klage erst nach Entscheidung<br/>in voller Besetzung<br/>— <a href='{{ELI}}#art-z25_abs-z4' target='_blank' rel='noopener'>§25 IV S.2</a>"])
        klage(["Klage im Verwaltungsrechtsweg gegen<br/>Aufnahme oder Ablehnung der Streichung<br/>— <a href='{{ELI}}#art-z25_abs-z1' target='_blank' rel='noopener'>§25 I</a>; gegen den Bund, vertreten<br/>durch die Bundeszentrale — <a href='{{ELI}}#art-z25_abs-z3' target='_blank' rel='noopener'>§25 III</a>;<br/>keine aufschiebende Wirkung — <a href='{{ELI}}#art-z25_abs-z4' target='_blank' rel='noopener'>§25 IV</a>"])
    end

    antrag --> offensichtlich
    vonAmts --> offensichtlich
    offensichtlich -->|Ja| eingestellt
    offensichtlich -->|Nein| anhoerung
    offensichtlich -.->|"Nein, bei digitalem<br/>Dienst"| stellungZAS
    stellungZAS -.-> vereinfacht
    anhoerung --> vereinfacht
    vereinfacht -->|Ja| einstimmig
    vereinfacht -->|Nein| voll
    einstimmig -->|"Nein"| voll
    einstimmig -->|"Ja"| zustellung
    voll --> zustellung
    zustellung -->|"nach vereinfachtem<br/>Verfahren"| antragVoll
    zustellung -->|"nach voller<br/>Besetzung"| klage
    zustellung -.->|"Nichtaufnahme"| klageBehoerde
    antragVoll -->|Ja| vollNachAntrag
    antragVoll -->|Nein| keineKlage
    vollNachAntrag --> klage

    style eingestellt fill:#f8d7da,stroke:#c0392b
    style keineKlage fill:#fff3cd,stroke:#c9a227
    style klage fill:#fff3cd,stroke:#c9a227
    style klageBehoerde fill:#fff3cd,stroke:#c9a227
