---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  target_option?: "_blank" | "_self";
  href?: string;
  popovertarget?: string;
  preline?: string;
  body?: string;
  subline?: string;
  image?: ImageMetadata;
  imageAlt?: string | null;
  imageSource?: string;
  interactive?: boolean;
}

const {
  preline,
  title,
  target_option = "_self",
  href,
  popovertarget,
  subline,
  body,
  image,
  imageAlt,
  imageSource,
  interactive = !!href || !!popovertarget,
} = Astro.props;

const hasFooter = Astro.slots.has("footer");
---

<article
  class:list={["kern-card", interactive ? "kern-card--interactive" : undefined]}
>
  {
    image && imageAlt !== undefined && (
      <div class="kern-card__media relative">
        <Image
          src={image}
          alt={imageAlt}
          class="h-208 object-cover"
          densities={[1, 2]}
          width="382"
          height="208"
          quality={100}
        />
        {imageSource && (
          <p class="absolute right-0 bottom-0 w-auto! rounded-none! bg-black/40 px-4 text-xs text-white">
            Quelle: {imageSource}
          </p>
        )}
      </div>
    )
  }
  <div class="kern-card__container">
    <header class="kern-card__header">
      <slot name="pre-header" />
      <hgroup>
        {preline && <p class="kern-preline">{preline}</p>}
        <h2 class="kern-title">
          {
            href ? (
              /* prettier-ignore */ <a href={href} class="kern-link--stretched hyphens-auto [word-break:break-word]" target={target_option}>{title}
              </a>
            ) : popovertarget ? (
              <button
                type="button"
                popovertarget={popovertarget}
                class="kern-link--stretched w-full text-left [word-break:break-word] hyphens-auto"
              >
                {title}
              </button>
            ) : (
              title
            )
          }
        </h2>
        {subline && <p class="kern-subline">{subline}</p>}
      </hgroup>
    </header>
    <section class="kern-card__body">
      {body && <p class="kern-body hyphens-manual">{body}</p>}
      <slot />
    </section>
    {
      hasFooter && (
        <footer class="kern-card__footer">
          <slot name="footer" />
        </footer>
      )
    }
  </div>
</article>
