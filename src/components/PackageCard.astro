---
import type { HTMLAttributes } from "astro/types";
import Badge from "./Badge.astro";
import { tv } from "@/utils/tv";

/**
 * Card with a title, an optional icon, and an optional badge.
 * Pass the icon in the `icon` slot.
 * The default slot is placed below the title: use `h4` and `p` elements, each `h4` gets a top margin.
 *
 * @example
 * <PackageCard title="Titel" type="Label">
 *   <Icon slot="icon" />
 *   <h4 class="kern-subline">Zwischentitel</h4>
 *   <p class="kern-body">Kurzer Text.</p>
 * </PackageCard>
 */
interface Props extends HTMLAttributes<"article"> {
  /** Rendered as an h3. */
  title: string;
  /** Label shown as a badge in the top-right corner. */
  type?: string;
}

const styles = tv({
  base: "border-kern-border-contextual flex flex-col rounded-sm border bg-white p-24 [&>h4]:mt-16",
});

const { title, type, class: className, ...attrs } = Astro.props;
---

<article class={styles({ class: className })} {...attrs}>
  <h3 class="my-8">{title}</h3>
  <div class="flex items-start gap-8 -order-1">
    {Astro.slots.has("icon") && (
      <div
        class="text-cosmic-blue-base size-48 [&>svg]:size-full"
        aria-hidden="true"
      >
        <slot name="icon" />
      </div>
    )}
    {type && (
      <Badge class="ml-auto" look="outline">
        {type}
      </Badge>
    )}
  </div>
  <slot />
</article>
