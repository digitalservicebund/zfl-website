---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import IconZoomIn from "~icons/ic/outline-zoom-in";
import Modal from "./Modal.astro";

interface Props extends Omit<
  HTMLAttributes<"img">,
  "src" | "alt" | "width" | "height"
> {
  src: ImageMetadata;
  alt: string;
  zoom?: boolean;
  width?: number | `${number}`;
  height?: number | `${number}`;
}

const { zoom = false, src, alt, ...attrs } = Astro.props;
const id = crypto.randomUUID();
const ariaLabel = "Bild in neuem Tab öffnen";
---

{zoom ? (
  <>
    <button
      popovertarget={id}
      class="relative block cursor-zoom-in"
      aria-label={ariaLabel}
    >
      <Image src={src} alt={alt} {...attrs} />
      <span
        class="text-cosmic-blue-base absolute bottom-16 left-16 flex h-32 w-32 items-center justify-center"
        aria-hidden="true"
      >
        <IconZoomIn class="h-20 w-20" />
      </span>
    </button>
    <Modal id={id} headless>
      <img src={src.src} alt={alt} />
    </Modal>
  </>
) : (
  <Image src={src} alt={alt} {...attrs} />
)}
