---
import { tv, type VariantProps } from "tailwind-variants";

interface Props extends VariantProps<typeof styles> {
  class?: string;
}

const styles = tv({
  base: "breakout py-lg",
  variants: {
    level: {
      root: "bg-cosmic-blue-base text-white",
      main: "bg-lavender-400",
      sub: "bg-lavender-400",
      plain: "bg-transparent",
    },
  },
  defaultVariants: {
    level: "sub",
  },
});

const { class: className, level } = Astro.props;
---

<div class={styles({ level, className })}>
  <slot />
</div>

<style>
  div {
    :global(h1) {
      margin-bottom: 24px;
    }
    :global(p) {
      font-size: var(--kern-typography-font-size-large-static, 21px);
      line-height: var(--kern-typography-line-height-large-static, 32px);
    }
  }
</style>
