---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";
import { tv } from "@/utils/tv";

/**
 * Vertical timeline. Use `TimelineListItem` for the items.
 * Dot and line color: `--color-timeline-list` from the `@theme` in global.css.
 *
 * @example
 * <TimelineList variant="changelog">
 *   <TimelineListItem type="year" label="2026" />
 *   <TimelineListItem label="Oktober 2026">
 *     <h3>Titel</h3>
 *     <p>Kurzer Text.</p>
 *   </TimelineListItem>
 * </TimelineList>
 */
interface Props extends HTMLAttributes<"ol">, VariantProps<typeof styles> {}

// Sets the default spacing of the items (TimelineListItem). `:where()` has zero
// specificity, so classes on an item override it.
const styles = tv({
  base: "list-unstyled scroll-my-40",
  variants: {
    /** `changelog`: room for year badges, more spacing and indentation. Default: `default`. */
    variant: {
      default: "[:where(&>li)]:pb-24 [:where(&>li)]:pl-40",
      changelog: "ml-26 [:where(&>li)]:pb-40 [:where(&>li)]:pl-48",
    },
  },
  defaultVariants: {
    variant: "default",
  },
});

const { variant, class: className, ...attrs } = Astro.props;
---

<ol role="list" class={styles({ variant, class: className })} {...attrs}>
  <slot />
</ol>
