---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";
import { tv } from "@/utils/tv";

/**
 * Timeline, vertical by default. Use `TimelineListItem` for the items.
 * `variant="horizontal"` shows the items side by side from `lg`, e.g. for steps.
 * Dot and line color: `--color-timeline-list` from the `@theme` in global.css.
 *
 * @example
 * <TimelineList variant="changelog">
 *   <TimelineListItem type="year" label="2026" />
 *   <TimelineListItem label="Oktober 2026">
 *     <h3>Titel</h3>
 *     <p>Kurzer Text.</p>
 *   </TimelineListItem>
 * </TimelineList>
 */
interface Props extends HTMLAttributes<"ol">, VariantProps<typeof styles> {}

const styles = tv({
  base: [
    "list-unstyled scroll-my-40",
    "[:where(&>li)]:pb-24 [:where(&>li)]:pl-40",
  ],
  variants: {
    /**
     * - `changelog`: room for year badges, more spacing and indentation
     * - `horizontal`: vertical on small screens, one column per item from `lg`
     */
    variant: {
      default: "",
      changelog: "ml-26 [:where(&>li)]:pb-40 [:where(&>li)]:pl-48",
      horizontal:
        "timeline-horizontal lg:grid lg:auto-cols-fr lg:grid-flow-col lg:gap-32 lg:[:where(&>li)]:p-0",
    },
  },
  defaultVariants: {
    variant: "default",
  },
});

const { variant, class: className, ...attrs } = Astro.props;
---

<ol role="list" class={styles({ variant, class: className })} {...attrs}>
  <slot />
</ol>
