---
import Self from "@/components/global/AccordeonMenuLevel.astro";
import { twMerge } from "tailwind-merge";

export type AccordeonNavigationEntry = {
  path: string;
  label: string;
  children: AccordeonNavigationEntry[];
  isCurrent: boolean;
  isInCurrentBranch: boolean;
};

interface Props {
  entries: AccordeonNavigationEntry[];
  currentPath: string;
  level?: number;
}

const { entries, currentPath, level = 0 } = Astro.props;

function isFirstLevelChildWithChildren(
  entry: AccordeonNavigationEntry,
  currentLevel: number,
) {
  return currentLevel === 1 && entry.children.length > 0;
}

function linkStyle(isCurrent = false) {
  return twMerge(
    "link-unstyled kern-body block rounded-sm",
    !isCurrent && "hover:bg-cosmic-blue-base hover:text-white",
    isCurrent && "bg-lavender-surface-highlight font-bold",
  );
}

function indentStyle(currentLevel: number) {
  const paddingLeft =
    currentLevel > 1
      ? "var(--kern-metric-space-x-large)"
      : "var(--kern-metric-space-small)";
  return `padding: var(--kern-metric-space-small) var(--kern-metric-space-small) var(--kern-metric-space-small) ${paddingLeft}`;
}
---

{
  entries.map((entry) =>
    isFirstLevelChildWithChildren(entry, level) ? (
      <details open={entry.isInCurrentBranch}>
        <summary class="kern-accordion__header hover:bg-cosmic-blue-base rounded-sm hover:text-white">
          <a
            href={entry.path}
            style={indentStyle(level)}
            class={linkStyle(entry.isCurrent)}
            aria-current={entry.isCurrent ? "page" : undefined}
            @click.stop
          >
            {entry.label}
          </a>
          <span
            class="kern-icon kern-icon--arrow-down kern-icon--default accordion-icon-open"
            aria-hidden="true"
          />
          <span
            class="kern-icon kern-icon--chevron-right kern-icon--default accordion-icon-closed"
            aria-hidden="true"
          />
        </summary>
        <section class="kern-accordion__body">
          <Self
            entries={entry.children}
            currentPath={currentPath}
            level={level + 1}
          />
        </section>
      </details>
    ) : (
      <>
        <a
          href={entry.path}
          class={linkStyle(currentPath === entry.path)}
          style={indentStyle(level)}
          aria-current={currentPath === entry.path ? "page" : undefined}
        >
          {entry.label}
        </a>
        {entry.children.length > 0 && (
          <Self
            entries={entry.children}
            currentPath={currentPath}
            level={level + 1}
          />
        )}
      </>
    ),
  )
}

<style>
  .kern-accordion__header,
  .kern-accordion__body {
    padding: 0;
  }

  .kern-accordion__header a {
    flex: 1;
  }

  .kern-accordion__header:hover .kern-icon {
    background-color: var(--kern-color-white);
  }
  .kern-accordion__header:hover .a {
    color: var(--kern-color-white);
  }

  a,
  details {
    margin-top: 8px;
  }

  .kern-accordion__header::after {
    display: none;
  }

  details > summary .accordion-icon-open {
    display: none;
  }

  details[open] > summary .accordion-icon-open {
    display: inline-flex;
  }

  details[open] > summary .accordion-icon-closed {
    display: none;
  }
</style>
