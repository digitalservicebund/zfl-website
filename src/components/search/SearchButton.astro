---
import { twMerge } from "tailwind-merge";

type Props = {
  class?: string;
  keyboardToggle?: boolean;
  "aria-label"?: string;
};

const {
  class: className,
  keyboardToggle,
  "aria-label": ariaLabel = "Suche öffnen",
  ...props
} = Astro.props;
---

<button
  class={twMerge(
    "flex items-center cursor-pointer select-none gap-8",
    className,
  )}
  aria-label={ariaLabel}
  {...(keyboardToggle ? { "aria-keyshortcuts": "Control+k Meta+k" } : {})}
  type="button"
  {...props}
>
  <slot />
</button>
