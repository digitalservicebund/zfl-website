---
import { twMerge } from "tailwind-merge";

type Props = {
  class?: string;
  keyboardToggle?: boolean;
};

const { class: className, keyboardToggle, ...props } = Astro.props;
---

<button
  class={twMerge(
    "flex items-center cursor-pointer select-none gap-8",
    className,
  )}
  aria-label="Suche öffnen"
  {...keyboardToggle ? { "aria-keyshortcuts": "Control+k Meta+k" } : {}}
  type="button"
  {...props}
>
  <slot />
</button>
