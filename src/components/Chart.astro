---
import "charts.css/dist/charts.min.css";

export interface ChartDataPoint {
  x: string | number;
  y: number;
}

export interface ChartSeries {
  label: string;
  values: ChartDataPoint[];
}

interface Props {
  data: ChartSeries[];
  /** Stack series on top of each other instead of grouping them side by side. */
  stack?: boolean;
  /** Accessible name for the chart, exposed as a screen-reader-only table caption. */
  title?: string;
  class?: string;
  type?: "column" | "pie";
}

const {
  data,
  type = "column",
  stack = false,
  title,
  class: className,
} = Astro.props;

const isPie = type === "pie";

const seriesColors = [
  "var(--color-cosmic-blue-base)",
  "var(--color-cosmic-blue-400)",
];
const colorFor = (index: number) => seriesColors[index % seriesColors.length];

// Categories are taken from the first series; every series is expected to
// provide one value per category, aligned by index.
const categories = data[0]?.values.map((point) => String(point.x)) ?? [];

const rows = categories.map((_, categoryIndex) =>
  data.map((series) => series.values[categoryIndex]?.y ?? 0),
);

const axisMax = stack
  ? Math.max(
      0,
      ...rows.map((row) => row.reduce((sum, value) => sum + value, 0)),
    )
  : Math.max(0, ...rows.flat());

// Pie charts render every cell (across all categories and series) as a
// slice of a single circle, drawn via cumulative --start/--end fractions
// (0-1) instead of the --size used by column/bar charts. Cells all overlay
// the same tbody, so ordering follows the row/series iteration below.
const pieTotal = rows.flat().reduce((sum, value) => sum + value, 0);
let pieCumulative = 0;
const pieStartEnd = (value: number) => {
  const start = pieTotal > 0 ? pieCumulative / pieTotal : 0;
  pieCumulative += value;
  const end = pieTotal > 0 ? pieCumulative / pieTotal : 0;
  return { start, end };
};

const isMultiSeries = data.length > 1;

const colorVars = data
  .map((_, index) => `--color-${index + 1}: ${colorFor(index)};`)
  .join(" ");

const formatValue = (value: number) => value.toLocaleString("de-DE");

// The pie tds all cover the full circle (so their transparent areas can
// overlay each other for the conic-gradient trick), which means whichever
// td paints last would otherwise swallow hover/focus for the whole circle.
// Clipping this wedge shape onto ::before (see <style> below) restricts the
// actual hit area to the slice itself, without clipping the td's visible
// children (the value label and tooltip), which may extend past the wedge.
const pieClipPath = (start: number, end: number) => {
  const segments = Math.max(2, Math.ceil((end - start) * 64));
  const points = ["50% 50%"];
  for (let i = 0; i <= segments; i++) {
    const fraction = start + ((end - start) * i) / segments;
    const angle = fraction * Math.PI * 2;
    const x = 50 + 50 * Math.sin(angle);
    const y = 50 - 50 * Math.cos(angle);
    points.push(`${x.toFixed(2)}% ${y.toFixed(2)}%`);
  }
  return `polygon(${points.join(", ")})`;
};
---

<div class:list={["zfl-chart", className]}>
  <table
    class:list={[
      "charts-css",
      type,
      !!title && "show-heading",
      "show-labels",
      stack ? "hide-data" : "data-outside pt-24",
      "data-spacing-10",
      stack && "stacked",
      isMultiSeries && !stack && "datasets-spacing-1",
    ]}
    style={colorVars}
  >
    {title && <caption class="kern-title text-left">{title}</caption>}
    <thead>
      <tr>
        <th scope="col"></th>
        {data.map((series) => (
          <th scope="col">{series.label}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {categories.map((category, categoryIndex) => (
        <tr>
          <th scope="row">{category}</th>
          {data.map((series, seriesIndex) => {
            const value = series.values[categoryIndex]?.y ?? 0;
            let cellStyle: string;
            if (isPie) {
              const { start, end } = pieStartEnd(value);
              cellStyle = `--start: ${start}; --end: ${end}; --pie-clip: ${pieClipPath(start, end)};`;
            } else {
              cellStyle = `--size: ${axisMax > 0 ? value / axisMax : 0};`;
            }
            return (
              <td
                style={`${cellStyle} --color: ${colorFor(seriesIndex)};`}
                tabindex="0"
              >
                <span class="data kern-body kern-body--small kern-body--muted">
                  {formatValue(value)}
                </span>
                <span class="tooltip">
                  <span class="max-sm:hidden">{series.label}:</span>{" "}
                  {formatValue(value)}
                </span>
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>

  {isMultiSeries && (
    <ul class="charts-css legend legend-inline legend-circle" style={colorVars}>
      {data.map((series) => (
        <li>{series.label}</li>
      ))}
    </ul>
  )}
</div>

<style>
  .zfl-chart {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  table.charts-css {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    tbody {
      height: 100%;
    }
  }

  table.column.show-labels tbody {
    padding-top: 24px;
    padding-bottom: 8px;
  }

  table.show-heading caption {
    margin-bottom: 1em;
  }

  table.pie tbody {
    width: 67%;
    margin-inline: auto;

    td span.data {
      visibility: hidden;
    }
  }

  table.stacked tbody tr {
    gap: 2px;
  }

  table.column {
    --aspect-ratio: 4/3;

    tr th {
      transform: translateY(8px);
    }

    tr td {
      max-width: 80px;
      margin-inline: auto;
      border-radius: 2px;
    }
  }

  .tooltip {
    background-color: black;
    &::after {
      border-top-color: black;
    }
  }

  table.pie td {
    --tooltip-radius: 30%;
    --tooltip-angle: calc(0.5turn * var(--start, 0) + 0.5turn * var(--end, 0));
    /* Only the wedge-shaped ::before (see below) should receive hover/click. */
    pointer-events: none;

    .tooltip {
      inset-inline-start: calc(
        50% + var(--tooltip-radius) * sin(var(--tooltip-angle))
      );
      inset-block-end: calc(
        50% + var(--tooltip-radius) * cos(var(--tooltip-angle))
      );
    }

    &::before {
      clip-path: var(--pie-clip);
      pointer-events: auto;
    }
  }

  table td:focus-visible .tooltip {
    visibility: visible;
    opacity: 1;
  }

  .legend {
    height: auto;
    flex-shrink: 0;
    border: none;
    padding: 0;
    gap: 8px;

    li {
      line-height: 1.5;
      &::before {
        border: none;
        flex-shrink: 0;
      }
    }
  }
</style>
