---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import InfoPanel, {
  type Props as InfoPanelProps,
} from "@/components/InfoPanel.astro";
import { tv } from "@/utils/tv";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  imageBorder?: boolean;
  imageClass?: string;
  linkHref?: string;
  linkText?: string;
  icon?: string;
  look?: InfoPanelProps["look"];
  padding?: InfoPanelProps["padding"];
  panelClass?: InfoPanelProps["class"];
  reversed?: boolean;
}

const panelStyles = tv({
  base: "z-1 self-start lg:col-span-3 lg:w-600 lg:self-center",
  variants: {
    reversed: { true: "lg:col-start-4 lg:justify-self-end" },
  },
});

const imageStyles = tv({
  base: "object-cover lg:absolute lg:h-482 lg:w-727",
  variants: {
    reversed: {
      true: "lg:left-1",
      false: "lg:right-1",
    },
    imageBorder: { true: "border-lavender-base border" },
  },
});

const {
  image,
  imageAlt,
  imageBorder,
  imageClass,
  linkHref,
  linkText,
  icon = "arrow-forward",
  look = "gray",
  padding = "medium",
  panelClass,
  reversed = false,
} = Astro.props;
---

<div class="relative max-lg:space-y-24 lg:grid lg:h-482 lg:grid-cols-6 lg:items-center lg:overflow-hidden">
  <InfoPanel
    look={look}
    padding={padding}
    class={panelStyles({ class: panelClass, reversed })}
  >
    <slot />
    {linkHref && linkText && (
      <a class="inline-flex items-center gap-8 before:hidden" href={linkHref}>
        <span
          class=`kern-icon kern-icon--${icon} kern-icon--default`
          aria-hidden="true"
          style="background-color: currentColor"
        />
        <p>{linkText}</p>
      </a>
    )}
  </InfoPanel>
  <Image
    src={image}
    alt={imageAlt}
    class={imageStyles({ class: imageClass, reversed, imageBorder })}
  />
</div>
