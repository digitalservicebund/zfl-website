---
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

interface Props extends HTMLAttributes<"span">, VariantProps<typeof styles> {
  class?: string;
}

const styles = tv({
  base: "kern-badge",
  variants: {
    look: {
      hint: "text-cosmic-blue-base",
      gray: "bg-lavender-base",
      white: "bg-white",
      timeline:
        "kern-badge--small bg-[#F3F4F7] [&>span.kern-label]:font-normal",
    },
  },
});

const { class: className, look, ...attrs } = Astro.props;
---

<span class={styles({ look, className })} {...attrs}>
  <slot name="icon" />
  <span class="kern-label">
    <slot />
  </span>
</span>
