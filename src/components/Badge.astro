---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";
import { tv } from "@/utils/tv";

interface Props extends HTMLAttributes<"span">, VariantProps<typeof styles> {
  class?: string;
}

const styles = tv({
  base: "kern-badge",
  variants: {
    look: {
      hint: "text-cosmic-blue-base",
      gray: "bg-lavender-base",
      white: "bg-white",
      outline:
        "border-kern-contextual [&>span.kern-label]:text-kern-text-muted-contextual shrink-0 border bg-white [&>span.kern-label]:font-normal",
      timeline:
        "kern-badge--small bg-surface-default [&>span.kern-label]:font-normal",
      timelineYear:
        "border-cosmic-blue-base border bg-white [&>span.kern-label]:font-bold",
    },
  },
});

const { class: className, look, ...attrs } = Astro.props;
---

<span class={styles({ look, className })} {...attrs}>
  <slot name="icon" />
  <span class="kern-label">
    <slot />
  </span>
</span>
