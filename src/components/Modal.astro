---
import IconClose from "~icons/ic/round-close";

// Usage example:
// <button popovertarget="my-modal">Open Modal</button>
// <Modal id="my-modal">
//   <p>Main content goes here (default slot).</p>
// </Modal>

interface Props {
  id: string;
  headless?: boolean;
  contentClass?: string;
}

const {
  id,
  headless = false,
  contentClass = "max-w-a11y max-h-screen",
} = Astro.props;
const ariaLabel = "Hinweisfenster schließen";
---

<dialog
  id={id}
  popover
  class="pointer-events-none bg-transparent h-screen w-screen open:flex justify-center items-center"
>
  {headless ? (
    <button
      popovertarget={id}
      popovertargetaction="hide"
      aria-label={ariaLabel}
      class:list={[
        "zoom",
        "pointer-events-auto cursor-zoom-out max-h-screen max-w-screen lg:m-sm flex items-center justify-center",
      ]}
    >
      <slot />
    </button>
  ) : (
    <div
      class:list={[
        "p-md pb-lg pointer-events-auto overflow-auto rounded-sm bg-white",
        contentClass,
      ]}
    >
      <div class="mb-32 flex w-full justify-end">
        <button
          class="border-cosmic-blue-base text-cosmic-blue-base rounded-sm border p-8"
          popovertarget={id}
          aria-label={ariaLabel}
        >
          <IconClose class="h-24 w-24" />
        </button>
      </div>
      <slot />
    </div>
  )}
</dialog>

<style>
  dialog[popover] {
    transition:
      display 0.2s allow-discrete,
      overlay 0.2s allow-discrete;
  }

  dialog[popover] .zoom {
    scale: 1;
    opacity: 0;
    transition: all 0.16s ease-in;
  }

  dialog[popover]:popover-open .zoom {
    scale: 1;
    opacity: 1;
    transition-timing-function: ease-out;
  }

  dialog[popover]::backdrop {
    opacity: 0;
    background-color: color-mix(in oklab, var(--color-black) 20%, transparent);
    backdrop-filter: blur(0px);
    transition: all 0.2s ease;
  }

  dialog[popover]:popover-open::backdrop {
    opacity: 1;
    backdrop-filter: blur(2px);
  }

  @starting-style {
    dialog[popover]:popover-open .zoom {
      scale: 0.96;
      opacity: 0;
    }

    dialog[popover]:popover-open::backdrop {
      opacity: 0;
      backdrop-filter: blur(0px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zoom {
      scale: 1;
      opacity: 1;
    }

    .dialog[popover]:popover-open::backdrop {
      opacity: 1;
      backdrop-filter: blur(2px);
    }
  }
</style>
