---
import Hero from "@/components/Hero.astro";
import { begleitungen, schulungen } from "@/config/routes";
import Layout from "@/layouts/Layout.astro";
import Datawrapper from "@/components/Datawrapper.astro";

export const frontmatter = {
  title: "Zahlen und Fakten (neu)",
  isStagingOnly: true,
};
---

<Layout title={frontmatter.title}>
  <main class="breakout-grid">
    <Hero level="sub">
      <h1>Bessere Rechtsetzung in Zahlen</h1>
      <div slot="subtitle">
        <p>Auf dem Weg zum Ziel ist das unser aktueller Fortschritt</p>
      </div>
    </Hero>

    <section>
      <h2>Durch digitale Angebote unterstützen</h2>

      <div class="gap-lg py-md grid max-w-900 grid-cols-1 md:grid-cols-2">
        <Datawrapper>
          <iframe
            title="7.473 Besuche auf Websites"
            aria-label="Säulendiagramm (gestapelt)"
            id="datawrapper-chart-5zzYl"
            src="https://datawrapper.dwcdn.net/5zzYl/1/"
            style="width: 0; min-width: 100% !important; border: none;"
            height="527"
            data-external="1"></iframe>
        </Datawrapper>
        <iframe
          title="Dummy-Irgendwas"
          aria-label="Liniendiagramm"
          id="datawrapper-chart-f9Iti"
          src="https://datawrapper.dwcdn.net/f9Iti/1/"
          style="width: 0; min-width: 100% !important; border: none;"
          height="527"
          data-external="1"></iframe>
      </div>

      <h2>Schulungen</h2>
      <p>
        <a href={schulungen.path} class="kern-link">
          <span
            class="kern-icon kern-icon--arrow-forward kern-icon--default"
            aria-hidden="true"></span>
          Mehr zu unseren Schulungen erfahren
        </a>
      </p>

      <div class="gap-lg py-md grid max-w-900 grid-cols-1 md:grid-cols-2">
        <Datawrapper>
          <iframe
            class="row-span-2"
            title="x Vorhaben begleitet (dummy)"
            aria-label="Säulendiagramm (gruppiert)"
            id="datawrapper-chart-3chbq"
            src="https://datawrapper.dwcdn.net/3chbq/2/"
            style="width: 0; min-width: 100% !important; border: none;"
            height="500"
            data-external="1"></iframe>
        </Datawrapper>
        <div class="bg-lavender-200 p-24 text-2xl">
          <p>
            <span class="text-5xl font-bold">85 %</span> der Teilnehmenden bewerten
            Zeit als sinnvoll investiert
          </p>
        </div>
        <div class="bg-lavender-200 p-24 text-2xl">
          <p>
            <span class="text-5xl font-bold">90 %</span> der Teilnehmenden haben Mehrwert
            neuer Methoden verstanden
          </p>
        </div>
      </div>
      <h2>Vorhaben begleiten</h2>
      <p>
        <a href={begleitungen.path} class="kern-link">
          <span
            class="kern-icon kern-icon--arrow-forward kern-icon--default"
            aria-hidden="true"></span>
          Mehr zu unseren Regelungsbegleitungen erfahren
        </a>
      </p>

      <div class="gap-lg py-md grid max-w-900 grid-cols-1 md:grid-cols-2">
        <Datawrapper>
          <iframe
            title="x Vorhaben begleitet (dummy)"
            aria-label="Säulendiagramm (gruppiert)"
            id="datawrapper-chart-3chbq"
            src="https://datawrapper.dwcdn.net/3chbq/2/"
            style="width: 0; min-width: 100% !important; border: none;"
            height="500"
            data-external="1"></iframe>
        </Datawrapper>
        <Datawrapper>
          <iframe
            title="85% irgendwas"
            aria-label="Donut-diagramm"
            id="datawrapper-chart-lNElv"
            src="https://datawrapper.dwcdn.net/lNElv/1/"
            style="width: 0; min-width: 100% !important; border: none;"
            height="500"
            data-external="1"></iframe>
        </Datawrapper>
      </div>

      <h2>Neue Kompetenzen vermitteln</h2>
      <p>
        <a href={begleitungen.path} class="kern-link">
          <span
            class="kern-icon kern-icon--arrow-forward kern-icon--default"
            aria-hidden="true"></span>
          Mehr zu unseren Schulungen erfahren
        </a>
      </p>

      <p class="mt-md italic">Daten zuletzt aktualisiert am 1. August 2026</p>
    </section>
  </main>
</Layout>
