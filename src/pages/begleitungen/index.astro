---
import Hero from "@/components/Hero.astro";
import FeatureSet from "@/components/FeatureSet.astro";
import FeatureItem from "@/components/FeatureItem.astro";
import InfoPanel from "@/components/InfoPanel.astro";
import KernCard from "@/components/KernCard.astro";
import illustration from "./illustration.svg";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import Zitat from "@/pages/werkzeuge/_assets/ki/zitat.svg";
import analyseArbeitImg from "@/images/analyse-arbeit.jpg";
import datenrechtImg from "@/images/Zusammenarbeit.png";
import stromsteuerrechtImg from "@/images/Trainings.jpg";
import IconArrowDownward from "~icons/ic/baseline-arrow-downward";
import IconAdd from "~icons/ic/round-add";
import IconCalendarToday from "~icons/ic/round-calendar-today";
import IconComputer from "~icons/ic/round-computer";
import IconRadar from "~icons/ic/round-radar";
import IconDomain from "~icons/ic/round-domain";
import IconEditNote from "~icons/ic/round-edit-note";
import IconQuiz from "~icons/ic/round-quiz";
import IconRoute from "~icons/ic/round-route";
import IconStar from "~icons/ic/round-star";
import ImageTextOverlay from "@/components/ImageTextOverlay.astro";
import workshopImg from "@/images/regelungsbegleitung-workshop.jpg";
import PackageCard from "@/components/PackageCard.astro";
import OfferCard from "./_OfferCard.astro";

export const frontmatter = {
  title: "Regelungsbegleitung",
  sitemap: true,
};

const description =
  "Ein in Gesetzgebungspraxis erfahrenes interdisziplinäres Team unterstützt Sie dabei, die Regelung praxisnah, digitaltauglich und bürokratiearm zu gestalten. Vertraulich und mit individuellem Fokus auf Ihr Vorhaben stehen Ihnen während der Begleitung Kompetenzen in Design, Nutzerforschung, IT, Produkt- und Prozessmanagement direkt zur Verfügung.";
---

<Layout title={frontmatter.title} description={description}>
  <main class="breakout-grid" id="main">
    <Hero level="main" class="overflow-clip">
      <div class="items-center gap-32 md:flex">
        <div>
          <h1>Gezielte Unterstützung für Ihr Vorhaben</h1>
          <p>
            Im Rahmen einer Regelungsbegleitung ergänzt ein interdisziplinäres
            Team Ihre fachliche Expertise. Gemeinsam schaffen Sie die Grundlage
            für{" "}
            <b>
              praxisnahe, digitaltaugliche und adressatenorientierte Regelungen
            </b>
            .
          </p>
          <p>
            Haben Sie Interesse? Sie erreichen uns unter{" "}
            <a href="tel:015170622421">0151&nbsp;/&nbsp;7062&nbsp;2421</a>{" "}
            (Mo–Fr 9–15&nbsp;Uhr) oder per E-Mail an{" "}
            <a href="mailto:begleitung@zfl.bund.de">begleitung@zfl.bund.de</a>.
          </p>
          <a class="kern-btn kern-btn--primary mt-32" href="#leistungspakete">
            <IconArrowDownward class="kern-label" aria-hidden />
            <span class="kern-label">Zu den Angeboten</span>
          </a>
        </div>
        <Image
          class="hidden max-w-280 md:block lg:max-h-344 lg:max-w-600"
          src={illustration}
          alt=""
          aria-hidden
        />
      </div>
    </Hero>
    <section>
      <ImageTextOverlay
        image={workshopImg}
        imageAlt="Vier Teilnehmerinnen und Teilnehmer stehen in einem Büro an einem Poster einer Nutzendenreise und besprechen sich."
        look="lightLavender"
        panelClass="lg:w-624"
      >
        <h2>Was ist eine Regelungsbegleitung?</h2>
        <p>
          Regelungsbegleitungen sind ein Angebot des Zentrum für Legistik. Ein{" "}
          <b>interdisziplinäres Team</b> ergänzt Ihr legistisches Fachwissen um
          Kompetenzen aus den Bereichen Design, Nutzerzentrierung, IT und
          Projektmanagement.
        </p>
        <p>
          Vertraulich und in enger Abstimmung mit Ihnen erarbeitet das Team{" "}
          <b>zentrale Konzeptbausteine</b> Ihres Vorhabens, veranschaulicht
          komplexe Zusammenhänge und bezieht Adressatinnen und Adressaten aus
          der Praxis frühzeitig ein.
        </p>
        <p>
          Am Ende einer Begleitung haben Sie eine <b>fundierte Grundlage</b> für
          die weitere Erarbeitung Ihres Vorhabens. / auf der Sie Ihre Regelung
          aufbauen können / gestalten können
        </p>
      </ImageTextOverlay>

      <FeatureSet>
        <FeatureItem centered title="12 Ministerien unterstützt">
          <IconDomain slot="icon" />
        </FeatureItem>
        <FeatureItem centered title="Über 30 Vorhaben begleitet">
          <IconEditNote slot="icon" />
        </FeatureItem>
        <FeatureItem centered title="93 % empfehlen das Angebot weiter">
          <IconStar slot="icon" />
        </FeatureItem>
      </FeatureSet>
    </section>

    <section id="leistungspakete" class="breakout bg-lavender-400">
      <OfferCard />

      <h2>Punktuelle Unterstützung</h2>
      <p class="mb-md max-w-688">
        Für Vorhaben, die keine mehrwöchige Begleitung benötigen, bietet Ihnen
        das Team kompakte Arbeitspakete zur punktuellen Unterstützung.
      </p>
      <div class="grid gap-32 md:grid-cols-2">
        <PackageCard title="Problemanalyse" type="Workshop">
          <IconQuiz slot="icon" />
          <h4 class="kern-subline">Ausgangssituation</h4>
          <p class="kern-body">
            Ihr Vorhaben befindet sich noch am Anfang und Sie benötigen
            Unterstützung beim Erschließen der Thematik oder beim methodischen
            Vorgehen.
          </p>
          <h4 class="kern-subline">Angebot</h4>
          <p class="kern-body">
            Konzeption, Moderation und Nachbereitung eines zwei- bis
            dreistündigen Workshops, in dem vorhandene Informationen
            strukturiert und neue Perspektiven aufgedeckt werden.
          </p>
          <h4 class="kern-subline">Ergebnisse</h4>
          <p class="kern-body">
            Eine präzise Problembeschreibung, erste Konzeptansätze oder
            methodische Grundlagen für das weitere Vorgehen.
          </p>
        </PackageCard>
        <PackageCard title="Visualisierungen" type="Workshop">
          <IconRoute slot="icon" />
          <h4 class="kern-subline">Ausgangssituation</h4>
          <p class="kern-body">
            Sie benötigen für Ihren Regelungsentwurf eine visuelle Darstellung
            der Inhalte, Abläufe oder der beteiligten Personen und
            Organisationen.
          </p>
          <h4 class="kern-subline">Angebot</h4>
          <p class="kern-body">
            Konzeption, Moderation und Nachbereitung eines zwei- bis
            dreistündigen Workshops, in dem die Darstellungsart gemeinsam
            festgelegt und ausgearbeitet wird.
          </p>
          <h4 class="kern-subline">Ergebnisse</h4>
          <p class="kern-body">
            Ein bis zwei visuelle Darstellungen für Ihr Vorhaben, z.&nbsp;B. als
            Flussdiagramm oder Rulemap.
          </p>
        </PackageCard>
        <PackageCard title="Digitalcheck-Prüfung" type="Textarbeit">
          <IconComputer slot="icon" />
          <h4 class="kern-subline">Ausgangssituation</h4>
          <p class="kern-body">
            Sie arbeiten an einem Regelungsentwurf und möchten die{" "}
            <a href="https://digitalcheck.bund.de/prinzipien">
              Prinzipien des Digitalcheck
            </a>{" "}
            von Anfang an berücksichtigen und sicherstellen, dass die Inhalte
            schlüssig sind.
          </p>
          <h4 class="kern-subline">Angebot</h4>
          <p class="kern-body">
            Prüfung der Inhalte auf Plausibilität und Digitaltauglichkeit. Eine
            kursorische, unverbindliche Vorprüfung im Rahmen des Digitalcheck
            ist ebenfalls möglich.
          </p>
          <h4 class="kern-subline">Ergebnisse</h4>
          <p class="kern-body">
            Eine kommentierte Fassung Ihres Textes mit konkreten und fundierten
            Änderungsvorschlägen.
          </p>
        </PackageCard>
        <div class="flex flex-col gap-8 p-24">
          <IconAdd class="text-cosmic-blue-base size-48" aria-hidden="true" />
          <h3 class="mt-0">Ihr individuelles Angebot</h3>
          <p class="kern-body">
            Falls keine der aufgeführten Lösungen zu Ihrem Vorhaben passt,
            findet unser Team gemeinsam eine passende Lösung für Sie.
          </p>
        </div>
      </div>
    </section>
    <section>
      <InfoPanel look="blue" padding="large">
        <h2>Jetzt unverbindlich informieren!</h2>
        <p class="max-w-688">
          Rufen Sie uns an unter{" "}
          <a href="tel:015170622421" class="font-bold">
            0151&nbsp;/&nbsp;7062&nbsp;2421
          </a>{" "}
          (Mo–Fr 9–15&nbsp;Uhr) oder schreiben Sie eine E-Mail an{" "}
          <a href="mailto:begleitung@zfl.bund.de" class="font-bold">
            begleitung@zfl.bund.de
          </a>
          .
        </p>
      </InfoPanel>

      <FeatureSet>
        <FeatureItem
          centered
          title="Interdisziplinäres Team"
          body="Sie profitieren von umfassender Digital-, Visualisierungs- und Prozesskompetenz."
          titleClass="kern-heading-medium"
        >
          <IconRadar slot="icon" />
        </FeatureItem>
        <FeatureItem
          centered
          title="Individuelle Gestaltung"
          body="Formate, Methoden und Dauer werden auf Ihr Vorhaben zugeschnitten."
          titleClass="kern-heading-medium"
        >
          <IconCalendarToday slot="icon" />
        </FeatureItem>
        <FeatureItem
          centered
          title="Kompakte Abstimmung"
          body="Für die Zusammenarbeit genügen oft wenige Stunden pro Woche."
          titleClass="kern-heading-medium"
        >
          <IconStar slot="icon" />
        </FeatureItem>
      </FeatureSet>
    </section>

    <section class="breakout bg-surface-default">
      <figure class="flex flex-col items-center gap-16 text-center">
        <Zitat class="text-lavender-base mb-16" aria-hidden="true" />
        <blockquote class="max-w-688">
          <p class="kern-subline kern-subline--large kern-subline-dark">
            Die Zusammenarbeit war sehr hilfreich! Es sind neue Konzepte
            entstanden. Ich war sehr angetan von der Durchdringungstiefe in der
            Analyse. Das ist ein echter Mehrwert.
          </p>
        </blockquote>
        <figcaption>– Referent, BMJV</figcaption>
      </figure>
    </section>

    <section>
      <h2>Beispiele aus Regelungsbegleitungen</h2>
      <p>
        Einige Ergebnisse vergangener Regelungsbegleitungen finden Sie hier.
      </p>
      <div class="mt-md grid grid-cols-1 gap-32 md:grid-cols-3">
        <KernCard
          headingLevel={3}
          preline="BMLEH"
          title="Interdisziplinär zu besseren Gesetzen"
          subline="Thema: Dokumentations- und Meldepflichten"
          href="https://digitalservice.bund.de/blog/interdisziplinaer-zu-besseren-gesetzen"
          image={analyseArbeitImg}
          imageAlt="Mehrere Personen sitzen um einen Tisch mit ausgedruckten Unterlagen und bunten Klebezetteln."
        />
        <KernCard
          headingLevel={3}
          preline="NKR · BMDS · BK"
          title="Erst das Problem, dann die Lösung: Bürokratieabbau im Datenrecht"
          subline="Thema: Dokumentations- und Meldepflichten"
          href="https://digitalservice.bund.de/blog/erst-das-problem-dann-die-loesung-buerokratieabbau-im-datenrecht"
          image={datenrechtImg}
          imageAlt="Zwei Personen arbeiten an einem Whiteboard mit Notizen und Klebezetteln."
        />
        <KernCard
          headingLevel={3}
          preline="BMF"
          title="Aktuelles Beispiel für digitaltaugliche Regelungen: das Stromsteuerrecht"
          subline="Thema: Stromsteuerrecht"
          href="https://digitalservice.bund.de/blog/aktuelles-beispiel-fuer-digitaltaugliche-regelungen-das-stromsteuerrecht"
          image={stromsteuerrechtImg}
          imageAlt="Eine Hand zeichnet ein Prozessdiagramm auf ausgedrucktes Papier."
        />
      </div>
    </section>
  </main>
</Layout>
