---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Schedule from "./_schedule.astro";
import InfoPanel from "@/components/InfoPanel.astro";
import KernCard from "@/components/KernCard.astro";
import { Image } from "astro:assets";
import { ZFL_PHONE, ZFL_EMAIL_SCHULUNG } from "@/config/constants.ts";
import schulungenImg from "@/images/Schulungen.png";
import onlineSchulungImg from "@/images/online-schulung.jpg";
import visImg from "@/images/Trainings.jpg";
import trainTheTrainerImg from "@/images/train-the-trainer.jpg";
import computerImg from "@/images/computer.jpg";
import appointments from "./_appointments.json";

export const frontmatter = {
  title: "Schulungen",
  sitemap: true,
};

const description =
  "In den umsetzungsorientierten Schulungen des Zentrum für Legistik lernen Sie Methoden und Werkzeuge kennen, die Sie bei der Erarbeitung von praxisnahen und bürokratiearmen Regelungen unterstützen.";
---

<Layout title={frontmatter.title} description={description}>
  <main class="breakout-grid max-md:overflow-x-hidden">
    <Hero level="main">
      <div class="items-center gap-32 md:flex md:flex-row">
        <div>
          <h1>Schulungen</h1>
          <p>
            In den umsetzungsorientierten Schulungen des Zentrum für Legistik
            lernen Sie Methoden und Werkzeuge kennen, die Sie bei der
            Erarbeitung von praxisnahen und bürokratiearmen Regelungen
            unterstützen.
          </p>
        </div>
        <Image
          class="hidden h-344 w-530 md:block"
          src={schulungenImg}
          alt=""
          aria-hidden
        />
      </div>
    </Hero>
    <section>
      <h2 class="mb-32">Schulungen des Zentrum für Legistik</h2>
      <div class="space-y-80">
        <div>
          <h3>
            Regelungen digital- und praxistauglich gestalten - Tipps für den
            Digitalcheck <span class="whitespace-nowrap">(1,5 Stunden)</span>
          </h3>
          <p>
            Erfahren Sie, wie Sie Ihr Vorhaben digital- und praxistauglich,
            adressatenorientiert und bürokratiearm gestalten. In dieser
            kompakten 90-minütigen Online-Schulung erhalten Sie eine umfassende
            Einführung zu den folgenden Inhalten: Digitalcheck erfolgreich
            bearbeiten, digitaltaugliche Formulierungen, Anwenden der Prinzipien
            für Digitaltauglichkeit, Praxistauglichkeit berücksichtigen und
            EU-Interoperabilität.
          </p>
          <div>
            <Schedule appointments={appointments} caption="Nächste Termine" />
          </div>
        </div>
        <div>
          <h3>Visualisierung als Werkzeug der Besseren Rechtsetzung</h3>
          <p>
            In Kooperation mit der Bundesakademie für öffentliche Verwaltung
            (BAköV) bietet das ZfL im September ihre weiterentwickelte Schulung
            zur Rechtsvisualisierung an: Visualisierung als
            Modellierungswerkzeug für wirkungsorientierte Gesetzgebung „Recht
            gut gedacht – Recht besser gemacht! Visualisierung als Werkzeug der
            Besseren Rechtsetzung”.
          </p>
          <ul>
            <li>
              <p class="font-bold">
                Termin: Freitag, 11.09.2026 von 09:00-16:30 Uhr
              </p>
              Eine detaillierte Beschreibung, Infos zum Veranstaltungsort sowie
              die Anmeldung, finden Sie unter der RS 195.01/26 im IFOS.
              <br />
            </li>
          </ul>
          <a
            href="https://www.ifosbund.de/pub/Fortbildungsangebot/va_detail.xhtml?id=162289&from=%2Fpub%2FFortbildungsangebot%2Fva_suche.xhtml"
            target="_blank"
          >
            Zur Anmeldung (IFOS-BUND)
          </a>
        </div>
        <div>
          <h3>
            Basisschulung für Legistinnen und Legisten
            <span class="whitespace-nowrap"> (4 Tage)</span>
          </h3>
          <p>
            Umsetzungsperspektive verstehen, Visualisierungen erstellen,
            Entscheidungsbäume ausarbeiten, Rechtsförmlichkeit und verständliche
            Sprache sicherstellen
          </p>
          <p>
            Die Basisschulung wird aktuell überarbeitet. Sobald es neue Termine
            gibt, finden Sie diese hier.
          </p>
        </div>
      </div>
      <figure class="mt-80 space-y-24">
        <Image
          src={onlineSchulungImg}
          alt="Ein Mann leitet eine Präsentation vor einem Bildschirm mit der Aufschrift „Herzlich willkommen zur Online-Schulung“ für Personen an einem Besprechungstisch mit Laptops."
        />
        <figcaption>
          <p class="kern-subline kern-subline--small">
            Ausschnitt aus der Online-Schulung „Regelungen digitaltauglich und
            interoperabel gestalten”.
          </p>
        </figcaption>
      </figure>
    </section>
    <section>
      <InfoPanel id="anmeldung" look="blue" padding="center">
        <h2>Anmeldung</h2>
        <p>
          Schicken Sie uns für eine Anmeldung den Schulungs- oder Modul-Namen
          und Termin an die E-Mail{" "}
          <a href={ZFL_EMAIL_SCHULUNG.url}>{ZFL_EMAIL_SCHULUNG.display}</a> und
          wir bestätigen die Anmeldung.
        </p>
      </InfoPanel>
    </section>
    <section id="downloads" class="scroll-mt-md">
      <h2>Schulungsmaterialien herunterladen</h2>
      <p>
        Hier können Sie die Unterlagen (Foliensätze) zu den Schulungsangeboten
        des Zentrums für Legistik herunterladen.
      </p>
      <div class="mt-md gap-md grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        <KernCard
          preline="Präsentation zur Schulung"
          title="Regelungen digitaltauglich und interoperabel gestalten"
          image={computerImg}
          imageAlt="Symboldbild: Ein Laptop zeigt die fünf Prinzipien des Digitalchecks"
        >
          <p>
            Praktische Tipps für den Digitalcheck: Wir zeigen Ihnen, wie Sie
            mithilfe der fünf Prinzipien für digitaltaugliche Gesetzgebung Ihre
            Vorhaben praxisnah, digital umsetzbar und über EU-Grenzen hinweg
            kompatibel gestalten.
          </p>
          <a
            slot="footer"
            href="https://github.com/digitalservicebund/digitalcheck-content/blob/main/src/online-schulungen/2026-04__Digitalcheck_Online-Schulung_5_Prinzipien.pdf?raw=true"
            class="kern-btn kern-btn--secondary"
          >
            <span
              class="kern-icon kern-icon--download kern-icon--default"
              aria-hidden="true"
            ></span>
            <span class="kern-label">Foliensatz (PDF)</span>
          </a>
        </KernCard>
        <KernCard
          preline="Präsentation zur Schulung"
          title="Visualisierungen erstellen"
          image={visImg}
          imageAlt="Symbolbild: Erstellung eines Flussdiagrams"
        >
          <p>
            In dieser Schulung zeigen wir Ihnen, warum Visualisierung nützlich
            ist und mit welchen Methoden und Werkzeugen Sie Inhalte einfach
            darstellen und für den Digitalcheck nutzen können.
          </p>
          <a
            slot="footer"
            href="https://github.com/digitalservicebund/digitalcheck-content/blob/main/src/online-schulungen/2025-06_Digitalcheck%20Online-Schulung_Visualisieren.pdf?raw=true"
            class="kern-btn kern-btn--secondary"
          >
            <span
              class="kern-icon kern-icon--download kern-icon--default"
              aria-hidden="true"
            ></span>
            <span class="kern-label">Foliensatz (PDF)</span>
          </a>
        </KernCard>
        <KernCard
          preline="Präsentation zur Schulung"
          title="Train-The-Trainer"
          image={trainTheTrainerImg}
          imageAlt="Symbolbild: Training"
        >
          <p>
            Schulungsreihe in 3 Modulen zum Aufbau eines Kompetenzzentrums zur
            Gestaltung digitaltauglicher Gesetze: Von den fünf Prinzipien und
            EU-Interoperabilität über Praxischecks, Visualisierung und
            Beteiligungsformate bis zur strategischen Beratung im
            Gesetzgebungsprozess.
          </p>
          <a
            slot="footer"
            href="https://github.com/digitalservicebund/digitalcheck-content/blob/main/src/train-the-trainer-modul/2026_02_18_train-the-trainer-module.zip?raw=true"
            class="kern-btn kern-btn--secondary"
          >
            <span
              class="kern-icon kern-icon--download kern-icon--default"
              aria-hidden="true"
            ></span>
            <span class="kern-label">Foliensätze (3 PDFs in ZIP)</span>
          </a>
        </KernCard>
      </div>
    </section>
    <section class="space-y-40">
      <h2 id="schulungen-weitere" class="scroll-m-20">
        Weitere Angebote
      </h2>
      <InfoPanel padding="wide" look="lightLavender">
        <h3>Bundesstiftung Gleichstellung (Gleichstellungs-Check)</h3>
        <p>
          Die für ein Gesetzesvorhaben fachlich Zuständigen lernen in der
          Schulung, wie Gesetzentwürfe systematisch auf ihre Auswirkungen auf
          die Gleichstellung der Geschlechter geprüft werden können.
        </p>
        <ul>
          <li>
            <p class="font-bold">
              Schulung zur gleichstellungsorientierten Gesetzesfolgenabschätzung
              nach § 2 GGO
            </p>
            <p>
              Schulung an unterschiedlichen Tagen im November 2026 - digital und
              in Präsenz <br />
              <a
                href="https://www.gleichstellungs-check.de/de/topic/6.schulungen.html"
                target="_blank"
              >
                Mehr Informationen und Anmeldung
              </a>
            </p>
          </li>
        </ul>
      </InfoPanel>
      <InfoPanel padding="wide" look="lightLavender">
        <h3>Speyerer Zentrum für Gesetzgebung</h3>
        <p>
          Das Zentrum für Gesetzgebung an der Deutschen Universität für
          Verwaltungswissenschaften Speyer bietet im Bereich der
          Gesetzgebungslehre Seminare und wissenschaftliche Vertiefung an.
        </p>
        <ul>
          <li>
            <p class="font-bold">
              Wissen in Legistik und Rechtsetzung erweitern
            </p>
            Sommersemester 2026: Lehre und Weiterbildung zu den Themen Legistik
            und Rechtsetzung
            <br />
            <a
              href="https://www.uni-speyer.de/lehrstuehle/level-2-1/prof-dr-ruth-weber/speyerer-zentrum-fuer-gesetzgebung"
              target="_blank"
            >
              Mehr Informationen und Anmeldung
            </a>
          </li>
        </ul>
      </InfoPanel>
      <InfoPanel padding="wide" look="lightLavender">
        <h3>Statistisches Bundesamt - OnDEA</h3>
        <ul>
          <li>
            <p class="font-bold">Einführung in die Grundlagen der Legistik</p>
            Die Online-Datenbank des Erfüllungsaufwands (OnDEA) bietet
            Video-Tutorials zu unterschiedlichen Themen an
            <br />
            <a href="https://www.ondea.de/DE/ZfL/ZfL_node.html" target="_blank">
              Videos anzeigen
            </a>
          </li>
        </ul>
      </InfoPanel>
    </section>
    <section class="breakout bg-cosmic-blue-base text-white">
      <h2>Kontakt</h2>
      <p>
        Wir unterstützen Sie gerne persönlich in allen Phasen der
        Regelungsarbeit. Bei Fragen melden Sie sich unter:
      </p>
      <p>
        Telefon: <a href={ZFL_PHONE.url}>{ZFL_PHONE.display}</a>
      </p>
      <p>
        E-Mail:{" "}
        <a href={ZFL_EMAIL_SCHULUNG.url}>{ZFL_EMAIL_SCHULUNG.display}</a>
      </p>
    </section>
  </main>
</Layout>
