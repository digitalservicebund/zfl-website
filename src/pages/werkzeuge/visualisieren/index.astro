---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import KernCard from "@/components/KernCard.astro";
import IconDeviceHub from "~icons/ic/round-device-hub";
import IconWeb from "~icons/ic/round-web";
import IconPeople from "~icons/ic/round-people";
import IconDone from "~icons/ic/round-done";
import { werkzeuge_visualisieren_erstellen } from "@/config/routes";
import { getVisualisierungExamples } from "./_examples.ts";
import type { VisType } from "./_types";
import DiagramPreview from "./_DiagramPreview.svelte";
import { parseMmdFrontmatter } from "./_mmdFrontmatter.ts";
import { wrappingWidthFor } from "./_mermaidConfig.ts";
import { stripLinks } from "./_diagramExport.ts";

export const frontmatter = {
  title: "Gesetze visualisieren",
  isStagingOnly: true,
};

const wizardPath = werkzeuge_visualisieren_erstellen.path;

// Each card preselects its vis type in step 1 of the wizard.
const visTypeCards = [
  {
    preset: "flowchart",
    icon: IconDeviceHub,
    title: "Entscheidungslogiken prüfen",
    body: "Analysieren Sie die Logik und Struktur Ihrer Regelung. Ideal, um Zusammenhänge zu prüfen und bestehendes Recht schnell zu erfassen.",
    badge: "Regelbaum",
    benefit: "Frühzeitig Komplexität erkennen und reduzieren",
  },
  {
    preset: "swimlane",
    icon: IconWeb,
    title: "Vollzug veranschaulichen",
    body: "Visualisieren Sie die praktische Umsetzung Ihrer Regelung, um Prozessschritte klar zu erkennen und Ihr Vorhaben gezielt zu optimieren.",
    badge: "Flussdiagramm",
    benefit: "Chancen und Hürden der Digitalisierung erkennen",
  },
  {
    preset: "actors",
    icon: IconPeople,
    title: "Normadressaten identifizieren",
    body: "Machen Sie sichtbar, welche Zielgruppen Ihre Regelung betrifft, um die Interaktionen aller Beteiligten ganzheitlich zu erfassen.",
    badge: "Stakeholdermap",
    benefit: "Abstimmung vereinfachen, z.\u00a0B. im Ressort und mit Verbänden",
  },
] as const satisfies { preset: VisType; [key: string]: unknown }[];

// Hand-picked to show one example per vis type. Entries that no longer
// exist in the collection are skipped.
const featured = [
  { short: "AsylG", visualization: "Asylverfahren-Ablauf" },
  { short: "BEEG", visualization: "Anspruchsvoraussetzungen Elterngeld" },
  { short: "OZG", visualization: "Akteure und Zuständigkeiten" },
];
const mermaidSources = import.meta.glob<string>(
  "../../../content/ki-visualisierungen/*/*.mmd",
  { query: "?raw", import: "default" },
);
const examples = await getVisualisierungExamples();
const featuredExamples = (
  await Promise.all(
    featured.map(async ({ short, visualization }) => {
      const example = examples.find((e) => e.short === short);
      const option = example?.visOptions.find((o) => o.name === visualization);
      const loadSource =
        mermaidSources[
          `../../../content/ki-visualisierungen/${short}/${option?.filename}.mmd`
        ];
      if (!option || !loadSource) return undefined;
      // Links inside the labels would end up nested in the preview's link.
      const body = stripLinks(parseMmdFrontmatter(await loadSource()).body);
      // Per-diagram config, see _DiagramPreview.svelte
      const config = `---
config:
  htmlLabels: true
  flowchart:
    htmlLabels: true
    wrappingWidth: ${wrappingWidthFor(body)}
---
`;
      const params = new URLSearchParams({ norm: short, visualization });
      return {
        short,
        option,
        source: config + body,
        href: `${wizardPath}?${params}`,
      };
    }),
  )
).filter((e) => e !== undefined);
---

<Layout title={frontmatter.title}>
  {/* The wizard used to live at this path; forward old deep links. */}
  <script is:inline define:vars={{ wizardPath }}>
    const params = new URLSearchParams(window.location.search);
    if (params.has("norm") || params.has("visualization")) {
      window.location.replace(
        wizardPath + window.location.search + window.location.hash,
      );
    }
  </script>
  <script>
    // Remembers a user-test ?api= link before the visitor moves on to the wizard.
    import "../_shared/apiBase";
  </script>
  <main class="breakout-grid">
    <Hero>
      <h1>{frontmatter.title}</h1>
      <p>
        Visualisieren Sie Prozesse und Entscheidungslogiken in Ihrem
        Gesetzesvorhaben – mithilfe von künstlicher Intelligenz.
      </p>
    </Hero>

    <section>
      <h2 class="mb-16">Visualisierungen jetzt erstellen</h2>
      <p>
        Wählen Sie eine der folgenden Optionen, je nachdem, was Sie
        visualisieren möchten.
      </p>
      {/* Each benefit sits below its card; the subgrid keeps the benefits
          aligned across columns regardless of card height. */}
      <div class="mt-56 grid grid-cols-1 gap-x-32 gap-y-56 md:grid-cols-3 lg:gap-x-56">
        {visTypeCards.map(
          ({ preset, icon: Icon, title, body, badge, benefit }) => (
            <div class="grid gap-24 md:row-span-2 md:grid-rows-subgrid md:gap-y-56">
              <KernCard
                title={title}
                href={`${wizardPath}?${new URLSearchParams({ preset })}`}
              >
                <div
                  slot="pre-header"
                  class="text-cosmic-blue-base mb-24 flex w-full justify-center"
                >
                  <Icon class="size-74" aria-hidden="true" />
                </div>
                <p class="kern-body">{body}</p>
                <span class="kern-badge kern-badge--methode mt-16">
                  <span class="kern-label">{badge}</span>
                </span>
              </KernCard>
              <p class="flex items-start gap-16">
                <IconDone
                  class="text-cosmic-blue-base size-48 flex-none"
                  aria-hidden="true"
                />
                <span class="pt-12">{benefit}</span>
              </p>
            </div>
          ),
        )}
      </div>
    </section>

    {featuredExamples.length > 0 && (
      <section>
        <h2 class="pb-32">Beispiele ansehen</h2>
        <div class="grid grid-cols-1 gap-32 md:grid-cols-3">
          {featuredExamples.map(({ short, option, source, href }, i) => (
            <a
              href={href}
              class="bg-lavender-200 hover:bg-lavender-400 block h-240 overflow-hidden p-16 md:h-392"
            >
              <span class="sr-only">
                {short}: {option.name}
              </span>
              <DiagramPreview
                client:visible
                source={source}
                id={`beispiel-${i}`}
              />
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
