---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import AIDisclaimer from "../_shared/AIDisclaimer.astro";
import Wizard from "./_Wizard.svelte";
import { getCollection } from "astro:content";
import { basename } from "node:path";

export const frontmatter = {
  title: "Gesetze visualisieren",
  isStagingOnly: true,
};

const visualisierungen = await getCollection("kiVisualisierungen");
const examples = visualisierungen.map(({ data, filePath }) => ({
  ...data,
  // filePath preserves the on-disk casing, unlike the glob loader's
  // lowercased `id` (e.g. "HeizkostenV.yaml" -> id "heizkostenv").
  short: basename(filePath ?? "", ".yaml"),
}));
---

<Layout title={frontmatter.title} noMenu>
  <main>
    <Hero class="breakout-grid">
      <h1>{frontmatter.title}</h1>
      <p>
        Visualisieren Sie Prozesse und Entscheidungslogiken in Ihrem
        Gesetzesvorhaben – mithilfe von künstlicher Intelligenz.
      </p>
      <div class="mt-16">
        <a href="#wizard" class="kern-btn kern-btn--primary">
          <span class="kern-label">Jetzt starten</span>
        </a>
      </div>
    </Hero>
    <AIDisclaimer />
    <Wizard {examples} client:load />
  </main>
</Layout>
