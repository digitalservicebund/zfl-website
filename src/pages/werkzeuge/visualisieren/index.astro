---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Wizard from "./_Wizard.svelte";
import { getCollection } from "astro:content";
import { basename } from "node:path";

export const frontmatter = {
  title: "Gesetze visualisieren",
  isStagingOnly: true,
};

const visualisierungen = await getCollection("visualisierungen");
const examples = visualisierungen.map(({ data, filePath }) => ({
  ...data,
  // filePath preserves the on-disk casing, unlike the glob loader's
  // lowercased `id` (e.g. "HeizkostenV.yaml" -> id "heizkostenv").
  short: basename(filePath ?? "", ".yaml"),
}));
---

<Layout title={frontmatter.title}>
  <main class="breakout-grid">
    <Hero>
      <h1>{frontmatter.title}</h1>
    </Hero>
    <section>
      <Wizard {examples} client:load />
    </section>
  </main>
</Layout>
