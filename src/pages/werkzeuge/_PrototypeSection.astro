---
import type { ImageMetadata } from "astro";
import { tv, type VariantProps } from "tailwind-variants";
import MediaText from "@/components/MediaText.astro";
import Image from "@/components/Image.astro";
import { ZFL_EMAIL } from "@/config/constants";
import { mailto } from "@/utils/mailtoHelper";

const tileStyles = tv({
  base: "flex aspect-[501/478] items-center justify-center px-24",
  variants: {
    look: {
      blue: "bg-darkblue-150",
      green: "bg-green-050",
      gray: "bg-(--kern-color-feedback-default-background)",
      violet: "bg-violet-050",
    },
  },
  defaultVariants: {
    look: "blue",
  },
});

interface Props extends VariantProps<typeof tileStyles> {
  title: string;
  tagline: string;
  image: ImageMetadata;
  imageAlt: string;
  reversed?: boolean;
  prototypeHref?: string;
}

const {
  title,
  tagline,
  image,
  imageAlt,
  look,
  reversed = false,
  prototypeHref,
} = Astro.props;
---

<MediaText reversed={reversed} class="flex-col-reverse md:gap-64">
  <h3 class="kern-heading-large p-0 mb-kern-default">{title}</h3>
  <p>
    <em>{tagline}</em>
  </p>
  <slot />
  <div class="flex flex-wrap gap-24 pt-16">
    <a
      class="kern-btn kern-btn--secondary"
      href={mailto(ZFL_EMAIL.url, `Interesse an: ${title}`)}
    >
      <span class="kern-label">Sprechen Sie uns an</span>
    </a>
    {prototypeHref && (
      <a
        class="kern-btn kern-btn--tertiary"
        href={prototypeHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="kern-label">Zum Online-Prototypen</span>
      </a>
    )}
  </div>
  <Image
    slot="media"
    src={image}
    alt={imageAlt}
    width={902}
    class="h-auto w-full shadow-[4px_7px_30.7px_0_rgba(0,0,0,0.1)]"
    zoom
    frameClass={tileStyles({ look })}
  />
</MediaText>
