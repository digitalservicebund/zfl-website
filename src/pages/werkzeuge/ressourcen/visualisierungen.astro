---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Modal from "@/components/Modal.astro";
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import KernCard from "@/components/KernCard.astro";
import { VISUALISIERUNGS_FILTER } from "@/content.config";
import { ZFL_EMAIL } from "@/config/constants";
import IconOpenInFull from "~icons/ic/outline-open-in-full";

const frontmatter = {
  title: "Beispiele für Visualisierungen",
  navLabel: "Visualisierungen",
  navOrder: 1,
};

function getBeispielvorhabenLinks(
  beispielvorhaben: CollectionEntry<"visualisierungen">["data"]["Beispielvorhaben"],
) {
  return [
    {
      href: beispielvorhaben.LinkRegelungstext,
      label: "Aktuelle Fassung",
    },
    {
      href: beispielvorhaben.NKRStellungnahmeLink,
      label: "NKR-Stellungnahme",
    },
  ].filter(({ href }) => href);
}

const visualisierungen = await Promise.all(
  (await getCollection("visualisierungen")).map(async (visualisierung) => ({
    ...visualisierung,
    Content: (await render(visualisierung)).Content,
    links: getBeispielvorhabenLinks(visualisierung.data.Beispielvorhaben),
  })),
);
---

<Layout title={frontmatter.title}>
  <main x-data="visualisierungenFilter" class="breakout-grid">
    <Hero level="plain">
      <h1>{frontmatter.title}</h1>
      <p>
        Hier finden Sie Visualisierungen, welche Legistinnen und Legisten beim
        Erarbeiten der Digitaltauglichkeit geholfen haben und veröffentlicht
        wurden.
      </p>
    </Hero>

    <div aria-hidden="true" x-ref="sentinel" class="h-px -translate-y-px"></div>
    <div
      class="breakout z-10 bg-white py-16 transition-shadow lg:sticky lg:top-0"
      x-data="{ stuck: false }"
      x-bind:class="stuck ? 'lg:shadow-md' : ''"
      x-init="
        new IntersectionObserver(([e]) => { stuck = !e.isIntersecting }, { threshold: [1] })
          .observe($refs.sentinel);
        stuck = false;
      "
    >
      <div class="-mb-16 flex flex-wrap items-center gap-8 pb-16">
        <span class="kern-label shrink-0">Filtern nach:</span>
        {
          VISUALISIERUNGS_FILTER.map((filter) => (
            <button
              class="h-32 shrink-0"
              @click={`toggleFilterType('${filter}')`}
            >
              <span
                class="kern-badge kern-badge--filter interactive"
                x-bind:data-inactive={`filterType && filterType !== '${filter}'`}
              >
                <span
                  class="kern-icon kern-icon--check kern-icon--default"
                  aria-hidden="true"
                  x-show={`filterType === '${filter}'`}
                />
                <span class="kern-label kern-label--small">{filter}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
    <div
      class="visualisierung-grid gap-y-2xl gap-x-md py-3xl grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3"
    >
      {
        visualisierungen.map((visualisierung) => {
          const modalId = `visualisierung-modal-${visualisierung.id}`;
          return (
            <div
              class="visualisierung-wrapper"
              x-bind:data-visible={`matchesFilter(${JSON.stringify(visualisierung.data.tags)})`}
            >
              <KernCard
                title={visualisierung.data.Titel}
                background="white"
                image={visualisierung.data.Bild.path}
                imageAlt={visualisierung.data.Bild.alternativeText}
                preline={visualisierung.data.Beispielvorhaben.Ressort}
                subline={visualisierung.data.Beispielvorhaben.Titel}
                popovertarget={modalId}
              >
                <span class="space-y-8 space-x-8">
                  {visualisierung.data.tags.map((tag) => (
                    <span class="kern-badge kern-badge--tag">
                      <span class="kern-label kern-label--small">{tag}</span>
                    </span>
                  ))}
                </span>
              </KernCard>
              <Modal
                id={modalId}
                contentClass="w-[1712px] max-w-[95vw] h-[926px] max-h-[95vh]"
              >
                <div class="xl:gap-lg xl:grid xl:grid-cols-3">
                  <div class="flex items-center justify-center xl:col-span-2">
                    <a
                      class="relative"
                      href={visualisierung.data.Bild.path.src}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Bild in neuem Tab öffnen"
                    >
                      <Image
                        src={visualisierung.data.Bild.path}
                        alt={visualisierung.data.Bild.alternativeText}
                        height={Math.min(
                          851,
                          visualisierung.data.Bild.path.height,
                        )}
                      />
                      <span
                        class="absolute right-0 bottom-0 flex h-40 w-40 items-center justify-center bg-gray-800/80 text-white"
                        aria-hidden="true"
                      >
                        <IconOpenInFull class="h-20 w-20" />
                      </span>
                    </a>
                  </div>
                  <div class="space-y-md">
                    <div class="space-y-8">
                      <p class="kern-preline">
                        {visualisierung.data.Beispielvorhaben.Ressort}
                      </p>
                      <p class="kern-heading-large">
                        {visualisierung.data.Titel}
                      </p>
                      <div class="kern-body">
                        <visualisierung.Content />
                      </div>
                    </div>
                    <p class="kern-body kern-body--muted">
                      Art der Visualisierung:{" "}
                      <b>{visualisierung.data.Visualisierungsart}</b>
                      {visualisierung.data.Visualisierungstool && (
                        <>
                          {" "}
                          · Software zur Erstellung:{" "}
                          <b>{visualisierung.data.Visualisierungstool}</b>
                        </>
                      )}
                    </p>
                    <div>
                      <p class="kern-subline">
                        {visualisierung.data.Beispielvorhaben.Titel}
                      </p>
                      {visualisierung.links.map(({ href, label }) => (
                        <>
                          <a href={href} target="_blank">
                            {label}
                          </a>
                          <br />
                        </>
                      ))}
                    </div>
                  </div>
                </div>
              </Modal>
            </div>
          );
        })
      }
      <p class="no-results" data-pagefind-ignore>
        <em>Keine Treffer</em>
      </p>
    </div>
    <Hero level="root">
      <h2>Sie möchten Ihr Beispiel hier sehen?</h2>
      <p>
        Wir nehmen gerne Vorschläge für Beispiele entgegen. Wenn Sie eine
        Visualisierung haben, schreiben Sie uns eine E-Mail an <a
          href={ZFL_EMAIL.url}>{ZFL_EMAIL.display}</a
        >. Wir melden uns zeitnah bei Ihnen.
      </p>
    </Hero>
  </main>
</Layout>

<script>
  import Alpine from "alpinejs";
  import { filterBarData } from "@/utils/filterBar";

  document.addEventListener("alpine:init", () => {
    Alpine.data("visualisierungenFilter", filterBarData);
  });
</script>

<style>
  .visualisierung-wrapper:not([data-visible="true"]) {
    display: none;
  }
  .no-results {
    display: none;
  }
  .visualisierung-grid:not(:has(.visualisierung-wrapper[data-visible="true"]))
    .no-results {
    display: block;
  }
</style>
