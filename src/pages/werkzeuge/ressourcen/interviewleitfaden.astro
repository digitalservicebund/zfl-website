---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import SidebarContainer from "@/components/global/SidebarContainer.astro";
import Toc from "@/components/global/Toc.astro";
import { slugify } from "@/utils/slugify";

const frontmatter = {
  title: "Akteurinnen und Akteure identifizieren und Interviews vorbereiten",
  navLabel: "Interviewleitfaden",
  navOrder: 3,
};

const toc = [
  {
    label: "Anleitung",
    children: [
      { label: "1. Relevante Akteurinnen und Akteure identifizieren" },
      { label: "2. Akteurinnen und Akteure identifizieren" },
      {
        label:
          "3. Halten Sie die Akteurinnen und Akteure in einer Übersicht fest",
      },
      { label: "4. Passende Interviewmethode wählen" },
      { label: "5. Gespräche durchführen" },
      { label: "6. Auswerten" },
    ],
  },
  {
    label: "Checkliste",
  },
  { label: "Relevante Quellen" },
].map((item) => ({
  ...item,
  id: slugify(item.label),
  children: item.children?.map((child) => ({
    ...child,
    id: slugify(child.label),
  })),
}));
---

<Layout title={frontmatter.title}>
  <main>
    <Hero class="breakout-grid" level="plain">
      <h1>{frontmatter.title}</h1>
      <p>
        Im folgenden Abschnitt finden Sie eine praxisnahe Anleitung zur
        strukturierten Vorbereitung und Durchführung von Interviews.
      </p>
      <p>
        Das Angebot wird derzeit weiterentwickelt, einschließlich der
        barrierefreien Optimierung der Vorlagen.
      </p>
      <p>
        Die Inhalte sind auf Basis von den unten aufgeführten Quellen
        entstanden.
      </p>
    </Hero>
    <SidebarContainer>
      <h2 id={toc[0].id}>{toc[0].label}</h2>
      <section class="breakout! bg-lavender-200">
        <h3>Relevante Akteurinnen und Akteure identifizieren</h3>
        <p>
          Zu Beginn wird ein Überblick über alle relevanten Akteurinnen und
          Akteure geschaffen. Ziel ist es, Personen oder Gruppen zu
          identifizieren, die von der Regelung betroffen sind oder an ihrer
          Umsetzung beteiligt sind. Dazu gehören sowohl direkt betroffene
          Akteure als auch solche, die vorbereitende, unterstützende oder
          steuernde Aufgaben übernehmen.
        </p>
        <p>
          Eine Einteilung nach Rollen hilft Ihnen dabei, die Akteurinnen und
          Akteure systematisch zu ordnen:
        </p>
      </section>
      <section>
        <h3>Halten Sie die Akteurinnen und Akteure in einer Übersicht fest</h3>
      </section>
      <section class="breakout! bg-lavender-200">
        <h3>Passende Interviewmethode wählen</h3>
      </section>
      <section>
        <h3>Gespräche durchführen</h3>
      </section>
      <section class="breakout! bg-lavender-200">
        <h3>Auswerten</h3>
      </section>
      <nav slot="sidebar" class="space-y-md">
        <p class="kern-heading-small">Auf dieser Seite</p>
        <Toc items={toc} />
      </nav>
    </SidebarContainer>
  </main>
</Layout>
