---
import Hero from "@/components/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import KernCard from "@/components/KernCard.astro";
import {
  werkzeuge_ressourcen,
  werkzeuge_praxistauglichkeit,
} from "@/config/routes";
import ressourcenImg from "./_assets/ressourcen.png";
import praxitauglichkeitImg from "./_assets/praxistauglichkeit.png";
import digitaltauglichkeitImg from "./_assets/digitaltauglichkeit.png";

export const frontmatter = {
  title: "Werkzeuge",
};
---

<Layout title={frontmatter.title}>
  <main class="breakout-grid">
    <Hero>
      <h1>{frontmatter.title}</h1>
      <p>
        In diesem Bereich finden Sie hilfreiche Informationen und Werkzeuge für
        eine Rechtsetzung, die adressatenorientiert, bürokratiearm, praxis- und
        digitaltauglich ist.
      </p>
    </Hero>
    <section class="gap-md grid grid-cols-2">
      <KernCard
        title={"Ressourcen"}
        background="white"
        image={ressourcenImg}
        imageAlt={""}
        href={werkzeuge_ressourcen.path}
        interactive={true}
        >Auf dieser Seite finden Sie Ressourcen, die Sie bei der Regelungsarbeit
        unterstützen. Diese Sammlung wird stetig ausgebaut.</KernCard
      >
      <KernCard
        title={"Praxistauglichkeit"}
        background="white"
        image={praxitauglichkeitImg}
        imageAlt={""}
        href={werkzeuge_praxistauglichkeit.path}
        interactive={true}
        >Die Modernisierungsagenda des Bundes gibt vor, neue Regelungen von
        Anfang an praxistauglich und bürokratiearm zu gestalten. Das Zentrum für
        Legistik unterstützt Sie dabei.</KernCard
      >
      <KernCard
        title={"Digitaltauglichkeit"}
        background="white"
        image={digitaltauglichkeitImg}
        imageAlt={""}
        href={werkzeuge_ressourcen.path}
        interactive={true}
        >Erfahren Sie hier, was Digitaltauglichkeit für Ihr Vorhaben bedeutet,
        welche Vorteile sie bietet, welche Vorhaben betroffen sind und wie sich
        der Digitalcheck nahtlos in die Phasen Ihres Regelungsentwurfs einfügt.</KernCard
      >
    </section>
  </main>
</Layout>
