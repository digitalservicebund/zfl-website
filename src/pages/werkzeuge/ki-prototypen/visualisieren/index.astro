---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import { werkzeuge_kiPrototypen_visualisieren_erstellen } from "@/config/routes";
import AIDisclaimer from "@/pages/werkzeuge/ki-prototypen/_shared/AIDisclaimer.astro";
import { getVisualisierungExamples } from "./_examples.ts";
import DiagramCard from "./_DiagramCard.svelte";
import DiagramSearch from "./_DiagramSearch.svelte";
import { hasMmd, loadMmd } from "./_previewSource.ts";
import type { SearchEntry } from "./_search.ts";

export const frontmatter = {
  title: "Prototyp: Gesetze visualisieren",
  sitemap: false,
};

const wizardPath = werkzeuge_kiPrototypen_visualisieren_erstellen.path;

// Hand-picked to show one example per vis type. Entries that no longer
// exist in the collection are skipped.
const featured = [
  { short: "BEEG", visualization: "Anspruchsvoraussetzungen Elterngeld" },
  { short: "AsylG", visualization: "Asylverfahren-Ablauf" },
  { short: "OZG", visualization: "Akteure und Zuständigkeiten" },
];
const examples = await getVisualisierungExamples();

function wizardHref(short: string, visualization: string) {
  const params = new URLSearchParams({ norm: short, visualization });
  return `${wizardPath}?${params}`;
}

// One entry per diagram that has a .mmd file
const searchEntries: SearchEntry[] = await Promise.all(
  examples.flatMap(({ short, title, owners, visOptions }) =>
    visOptions
      .filter(({ filename }) => hasMmd(short, filename))
      .map(async ({ name, filename = "", articles }) => ({
        key: `${short}/${filename}`,
        short,
        lawTitle: title,
        name,
        summary: (await loadMmd(short, filename)).summary,
        filename,
        href: wizardHref(short, name),
        articles,
        owners,
      })),
  ),
);

const featuredExamples = featured.flatMap(({ short, visualization }) => {
  const entry = searchEntries.find(
    (e) => e.short === short && e.name === visualization,
  );
  return entry ? [entry] : [];
});
---

<Layout title={frontmatter.title} excludeFromSearch>
  {/* The wizard used to live at this path; forward old deep links. */}
  <script is:inline define:vars={{ wizardPath }}>
    const params = new URLSearchParams(window.location.search);
    if (params.has("norm") || params.has("visualization")) {
      window.location.replace(
        wizardPath + window.location.search + window.location.hash,
      );
    }
  </script>
  <main class="breakout-grid" id="main">
    <Hero>
      <h1>{frontmatter.title}</h1>
      <p>
        Visualisieren Sie Prozesse und Entscheidungslogiken in Ihrem
        Gesetzesvorhaben – mithilfe von künstlicher Intelligenz.
      </p>
    </Hero>
    <section>
      <AIDisclaimer>
        <p>
          Wir erproben damit die KI-gestützte Visualisierung von Prozessen und
          Entscheidungslogiken in Gesetzesvorhaben um diese besser
          nachvollziehbar zu machen.
        </p>
        <ul>
          <li>Dieser Prototyp zeigt KI-generierte Inhalte</li>
          <li>
            Sie wurden nicht rechtlich geprüft, sie können unvollständig oder
            fehlerhaft sein
          </li>
        </ul>
      </AIDisclaimer>
    </section>

    <section>
      <h2>Visualisierungen jetzt erstellen</h2>
      <DiagramSearch client:load entries={searchEntries} />
    </section>

    {featuredExamples.length > 0 && (
      <section>
        <h2 class="pb-32">Beispiele ansehen</h2>
        <ul class="list-unstyled grid grid-cols-1 gap-24 md:grid-cols-3">
          {featuredExamples.map(
            ({ short, filename, name, href, owners, articles }) => (
              <li>
                <DiagramCard
                  client:load
                  short={short}
                  filename={filename}
                  title={name}
                  href={href}
                  owners={owners}
                  articles={articles}
                />
              </li>
            ),
          )}
        </ul>
      </section>
    )}
  </main>
</Layout>
