---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import FeatureSet from "@/components/FeatureSet.astro";
import FeatureItem from "@/components/FeatureItem.astro";
import IconShare from "~icons/ic/twotone-share";
import IconLightbulb from "~icons/ic/twotone-lightbulb";
import IconEye from "~icons/ic/twotone-remove-red-eye";
import { werkzeuge_kiPrototypen_visualisieren_erstellen } from "@/config/routes";
import AIDisclaimer from "@/pages/werkzeuge/ki-prototypen/_shared/AIDisclaimer.astro";
import { getVisualisierungExamples } from "./_examples.ts";
import DiagramCard from "./_DiagramCard.astro";
import { parseMmdFrontmatter } from "./_mmdFrontmatter.ts";
import { wrappingWidthFor } from "./_mermaidConfig.ts";
import { stripLinks } from "./_diagramExport.ts";

export const frontmatter = {
  title: "Prototyp: Gesetze visualisieren",
  sitemap: false,
};

const wizardPath = werkzeuge_kiPrototypen_visualisieren_erstellen.path;

// Hand-picked to show one example per vis type. Entries that no longer
// exist in the collection are skipped.
const featured = [
  { short: "BEEG", visualization: "Anspruchsvoraussetzungen Elterngeld" },
  { short: "AsylG", visualization: "Asylverfahren-Ablauf" },
  { short: "OZG", visualization: "Akteure und Zuständigkeiten" },
];
const mermaidSources = import.meta.glob<string>(
  "../../../../content/ki-visualisierungen/*/*.mmd",
  { query: "?raw", import: "default" },
);
const examples = await getVisualisierungExamples();
const featuredExamples = (
  await Promise.all(
    featured.map(async ({ short, visualization }) => {
      const example = examples.find((e) => e.short === short);
      const option = example?.visOptions.find((o) => o.name === visualization);
      const loadSource =
        mermaidSources[
          `../../../../content/ki-visualisierungen/${short}/${option?.filename}.mmd`
        ];
      if (!option || !loadSource) return undefined;
      // Links inside the labels would end up nested in the preview's link.
      const body = stripLinks(parseMmdFrontmatter(await loadSource()).body);
      // Per-diagram config, see _DiagramPreview.svelte
      const config = `---
config:
  htmlLabels: true
  flowchart:
    htmlLabels: true
    wrappingWidth: ${wrappingWidthFor(body)}
---
`;
      const params = new URLSearchParams({ norm: short, visualization });
      return {
        short,
        option,
        source: config + body,
        href: `${wizardPath}?${params}`,
      };
    }),
  )
).filter((e) => e !== undefined);
---

<Layout title={frontmatter.title} excludeFromSearch>
  {/* The wizard used to live at this path; forward old deep links. */}
  <script is:inline define:vars={{ wizardPath }}>
    const params = new URLSearchParams(window.location.search);
    if (params.has("norm") || params.has("visualization")) {
      window.location.replace(
        wizardPath + window.location.search + window.location.hash,
      );
    }
  </script>
  <main class="breakout-grid" id="main">
    <Hero>
      <h1>{frontmatter.title}</h1>
      <p>
        Visualisieren Sie Prozesse und Entscheidungslogiken in Ihrem
        Gesetzesvorhaben – mithilfe von künstlicher Intelligenz.
      </p>
    </Hero>
    <section>
      <AIDisclaimer>
        <p>
          Wir erproben damit die KI-gestützte Visualisierung von Prozessen und
          Entscheidungslogiken in Gesetzesvorhaben um diese besser
          nachvollziehbar zu machen.
        </p>
        <ul>
          <li>Dieser Prototyp zeigt KI-generierte Inhalte</li>
          <li>
            Sie wurden nicht rechtlich geprüft, sie können unvollständig oder
            fehlerhaft sein
          </li>
        </ul>
      </AIDisclaimer>
    </section>

    <section>
      <h2>Warum eine Visualisierung erstellen?</h2>
      <FeatureSet>
        <FeatureItem>
          <IconShare slot="icon" class="size-full" />
          <p>
            Frühzeitig <strong>Komplexität</strong> erkennen und{" "}
            <strong>reduzieren</strong>
          </p>
        </FeatureItem>
        <FeatureItem>
          <IconLightbulb slot="icon" class="size-full" />
          <p>
            <strong>Chancen und Hürden</strong> der Digitalisierung erkennen
          </p>
        </FeatureItem>
        <FeatureItem>
          <IconEye slot="icon" class="size-full" />
          <p>
            <strong>Abstimmung</strong> vereinfachen, z.&nbsp;B. im Ressort und
            mit Verbänden
          </p>
        </FeatureItem>
      </FeatureSet>
    </section>

    <section class="breakout bg-lavender-200">
      <h2 class="mb-24">Visualisierung jetzt starten</h2>
      <p class="mb-32">
        Visualisieren Sie den Vollzug Ihrer Regelung, um Zusammenhänge besser zu
        verstehen und Ihr Vorhaben zu optimieren.
      </p>
      <div>
        <a href={wizardPath} class="kern-btn kern-btn--primary">
          <span class="kern-label">Jetzt starten</span>
        </a>
      </div>
    </section>

    {featuredExamples.length > 0 && (
      <section>
        <h2 class="pb-32">Beispiele ansehen</h2>
        <ul class="list-unstyled grid grid-cols-1 gap-24 md:grid-cols-3">
          {featuredExamples.map(({ short, option, source, href }, i) => (
            <li>
              <DiagramCard
                preline={short}
                title={option.name}
                href={href}
                source={source}
                id={`beispiel-${i}`}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>
