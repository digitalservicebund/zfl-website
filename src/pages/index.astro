---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import KernCard from "@/components/KernCard.astro";
import ImageTextOverlay from "@/components/ImageTextOverlay.astro";
import { ZFL_EMAIL, ZFL_PHONE } from "@/config/constants";
import allgemeinImage from "@/images/Trainings.jpg";
import zusammenarbeitImg from "@/images/Zusammenarbeit.png";
import schulungImage from "@/images/computer.jpg";
import fruehphaseImage from "@/images/fruehphase-mockup-cropped.png";
import ansatzImg from "@/images/Ansatz.jpg";
import stickyNotesImg from "@/images/sticky-notes.jpg";
import {
  schulungen,
  ueber_neueFruehphase,
  begleitungen,
  werkzeuge,
  ueber,
  bessereRechtsetzung,
} from "@/config/routes";
import { mailto } from "@/utils/mailtoHelper";

export const frontmatter = {
  title: "Zentrum für Legistik",
  sitemap: true,
};
---

<Layout title="">
  <main class="breakout-grid">
    <Hero level="root">
      <h1 class="max-w-a11y">
        Die zentrale Anlaufstelle für bessere Rechtsetzung
      </h1>
      <p>
        Das Zentrum für Legistik unterstützt Legistinnen und Legisten bei der
        Ausarbeitung von Regelungen, die betroffenenzentriert, praxistauglich
        und digital umsetzbar sind.
      </p>
    </Hero>
    <section class="space-y-48 lg:space-y-80">
      <div>
        <h2>Unsere Angebote</h2>
        <p>
          Das Zentrum für Legistik stellt mehrere Unterstützungsangebote zur
          Verfügung, die laufend weiterentwickelt werden.
        </p>
        <div class="grid grid-cols-1 gap-32 md:grid-cols-3">
          <KernCard
            title="Werkzeuge"
            target_option="_self"
            href={werkzeuge.path}
            body="Nutzen Sie Anleitungen und Hilfsmittel wie den Digitalcheck und den Rulemap Builder."
            image={allgemeinImage}
            imageAlt="Symbolbild: Erstellung eines Flussdiagrams"
            interactive
          />
          <KernCard
            title="Regelungsbegleitung"
            target_option="_self"
            href={begleitungen.path}
            body="Erhalten Sie individuelle Unterstützung für Ihr Vorhaben durch interdisziplinäre Teams – vertraulich und kostenfrei."
            image={zusammenarbeitImg}
            imageAlt="Mehrere Personen vor einem großen Whiteboard, an dem sie Klebepunkte an bereits vorhandenen Papieren und Post-its anbringen."
            interactive
          />
          <KernCard
            title="Schulungen"
            target_option="_self"
            href={schulungen.path}
            image={schulungImage}
            imageAlt="Symbolbild: Ein Laptop zeigt die fünf Prinzipien des Digitalchecks"
            body="Lernen Sie moderne Methoden und Werkzeuge der legistischen Arbeit kennen."
            interactive
          />
        </div>
      </div>
      <ImageTextOverlay
        image={fruehphaseImage}
        imageAlt="Das Bild zeigt einen Laptop-Bildschirm mit einer Webseite des Zentrums für Legistik, die ein Prozess zur frühen Phase der Gesetzgebung zeigt."
        linkHref={bessereRechtsetzung.path}
        linkText="Darstellung öffnen"
        look="lavender"
      >
        <h3>
          Wie gelingt eine praxistaugliche und bürokratiearme Rechtsetzung?
        </h3>
        <p>
          Das Zentrum für Legistik unterstützt Sie bereits in der
          Konzeptionsphase, Regelungen neu zu gestalten. Diese Übersicht zeigt,
          wie dies konkret aussehen könnte.
        </p>
      </ImageTextOverlay>
    </section>
    <section class="bg-lavender-400 breakout space-y-32">
      <h2>Auf dem Laufenden bleiben</h2>
      <div class="grid grid-cols-1 gap-24 md:grid-cols-3 md:gap-32">
        <KernCard
          title="Über uns"
          image={ansatzImg}
          imageAlt="Eine großflächige Grafik an einer Glaswand. Sie zeigt verschiedenfarbige Kreise mit Textinhalten."
        >
          <p>
            Erfahren Sie mehr über den Auftrag und die Herangehensweise des
            Zentrum für Legistik, aktuelle Arbeitspakete und Statistiken.
          </p>
          <div slot="footer">
            <a href={ueber.path} class="kern-btn kern-btn--secondary">
              <span class="kern-label">Mehr erfahren</span>
            </a>
          </div>
        </KernCard>
        <KernCard
          title="Im Fokus"
          image={stickyNotesImg}
          imageAlt="Symbolbild: Brainstorming"
        >
          <p>
            <a href={schulungen.path}>Neue Schulungstermine</a>: Melden Sie sich
            für Schulungen zur besseren Rechtsetzung an.
          </p>
          <p>
            <a href={ueber_neueFruehphase.path}>Neue Infoseite Frühphase</a>:
            Hier finden Sie alle Informationen zum Update für die frühe Phase
            der Rechtsetzung.
          </p>
          <p>
            <a
              class="text-link"
              href="https://bmds.bund.de/1-jahr-bmds"
              target="_blank"
            >
              1 Jahr Bundesministerium für Digitales und Staatsmodernisierung:
            </a>{" "}
            Das Zentrum für Legistik ist eine von vielen Initiativen, um den
            Staat schneller, digitaler und bürgernäher zu machen.
          </p>
        </KernCard>
        <KernCard title="Newsletter">
          <p>
            Der Newsletter des Zentrum für Legistik erscheint mehrmals im Jahr
            und informiert Sie über:
          </p>
          <ul>
            <li>
              Aktuelle Entwicklungen und Angebote im Bereich bessere
              Rechtsetzung
            </li>
            <li>
              Neue Funktionen von Werkzeugen und Arbeitshilfen (bspw.
              Digitalcheck)
            </li>
            <li>Neue Schulungstermine</li>
            <li>Aktuelle Anwendungsbeispiele</li>
            <li>Veranstaltungen</li>
          </ul>
          <p>
            Um sich anzumelden, schicken Sie uns eine kurze E-Mail an{" "}
            <a class="text-link" href={ZFL_EMAIL.url}>
              {ZFL_EMAIL.display}
            </a>
            .
          </p>
          <div slot="footer">
            <a
              class="kern-btn kern-btn--secondary"
              href={mailto(
                ZFL_EMAIL.url,
                "Anmeldung Zentrum für Legistik Newsletter",
                "Hiermit melde ich mich für den Zentrum für Legistik Newsletter an.",
              )}
            >
              <span
                class="kern-icon kern-icon--open-in-new"
                aria-hidden="true"
              ></span>
              <span class="kern-label">E-Mail Programm öffnen</span>
            </a>
          </div>
        </KernCard>
      </div>
    </section>
    <section class="breakout bg-cosmic-blue-base text-white">
      <h2>Kontakt</h2>
      <p>
        Sie haben Fragen zum Zentrum für Legistik oder den einzelnen Angeboten?
        Kontaktieren Sie uns.
      </p>
      <p>
        Telefon: <a href={ZFL_PHONE.url}>{ZFL_PHONE.display}</a>
      </p>
      <p>
        E-Mail: <a href={ZFL_EMAIL.url}>{ZFL_EMAIL.display}</a>
      </p>
    </section>
  </main>
</Layout>
