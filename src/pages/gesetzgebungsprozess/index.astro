---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import InfoPanel from "@/components/InfoPanel.astro";
import RegelungsprozessFlowWithLayout from "./_RegelungsprozessFlowWithLayout.svelte";
import { ZFL_EMAIL } from "@/config/constants";
import { kontakt } from "@/config/routes";

export const frontmatter = {
  title: "Wie gelingt eine praxistaugliche und bürgerfreundliche Gesetzgebung?",
  isStagingOnly: true,
};
---

<Layout title={frontmatter.title}>
  <main>
    <Hero class="breakout-grid">
      <h1 class="max-w-a11y">{frontmatter.title}</h1>
      <div slot="subtitle">
        <p>
          Komplexe Vorgaben und hoher Zeitdruck prägen den Alltag in der
          Gesetzgebung. Um verständliche und digital funktionierende Regelungen
          zu schaffen, braucht es keine neuen Vorschriften, sondern gezielte
          Unterstützung an den richtigen Stellen im etablierten Ablauf.
        </p>
        <p>
          Entdecken Sie Schritt für Schritt, wie Sie <strong
            >neue Potenziale</strong
          > nutzen und Ihre Arbeit im Gesetzgebungsverfahren spürbar <strong
            >vereinfachen</strong
          > können.
        </p>
      </div>
    </Hero>

    <RegelungsprozessFlowWithLayout client:load />

    <section class="breakout-grid" id="outro">
      <InfoPanel look="lightLavender" padding="wide">
        <h2>Machen Sie mit!</h2>
        <p>
          Wenn Sie Interesse haben, die Frühphase mitzugestalten, dann melden
          Sie sich gerne zu Tests und Gesprächen an. Schicken Sie uns eine
          E-Mail an <a class="font-bold" href={ZFL_EMAIL.url}
            >{ZFL_EMAIL.display}</a
          >.
        </p>
        <p>
          Wenn Sie an einem Vorhaben arbeiten, können Sie auch unsere Angebote
          nutzen.
        </p>
        <div class="mt-24 flex gap-8">
          <a href={kontakt.path} class="kern-btn kern-btn--primary"
            ><span class="kern-label">Zu den ZFL-Angeboten</span></a
          >
          <a href="#" class="kern-btn kern-btn--secondary"
            ><span class="kern-label">Zurück</span></a
          >
        </div>
      </InfoPanel>
    </section>
  </main>
</Layout>
