---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import RegelungsprozessFlowWithMinimap from "./_RegelungsprozessFlowWithMinimap.svelte";

export const frontmatter = {
  title: "Wie entstehen gute Regelungen?",
  isStagingOnly: true,
};
---

<Layout title={frontmatter.title}>
  <main>
    <Hero class="breakout-grid">
      <h1>{frontmatter.title}</h1>
      <p slot="subtitle">
        Eine neue Regelung, die praktikabel und bürokratiearm ist: Wie kommen
        wir dahin?<br />Hier zeigen wir ein Vorgehen zur Erarbeitung von
        Gesetzen, bei dem die Interessen aller Beteiligten und Betroffenen früh
        mitgedacht werden.
      </p>
    </Hero>

    <RegelungsprozessFlowWithMinimap client:load />
  </main>
</Layout>
